@model IEnumerable<COSMETICC.Models.Product>
@{
    ViewData["Title"] = "Danh sách yêu thích";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container py-5 wishlist-container">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm yêu thích của tôi</h3>
            <small class="text-muted">Danh sách các sản phẩm bạn đã lưu để theo dõi và mua sắm sau</small>
        </div>
        <a asp-controller="Product" asp-action="List" class="btn btn-sm btn-outline-danger px-3 fw-bold" style="border-color:#800020; color:#800020;">
            Tiếp tục mua sắm
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                var isDisc = p.PromoPrice.HasValue && p.PromoPrice < p.Price;
                var hasImages = p.ProductImages != null && p.ProductImages.Any();
                
                <div class="col-6 col-md-4 col-lg-3" id="wish-item-@p.Id">
                    <div class="wish-card h-100 d-flex flex-column text-start">
                        
                        <!-- Image Area with Remove Button -->
                        <div class="wish-img-box">
                            <button class="btn-remove-wish" onclick="removeWishlistItem(@p.Id)" title="Xóa khỏi danh sách yêu thích">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                            <a href="@Url.Action("Details", "Product", new { id = p.Id })">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/200x200?text=No+Image" : p.ImageUrl)" class="wish-img" alt="@p.Name" />
                            </a>
                        </div>

                        <!-- Info Area -->
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <span class="text-uppercase text-secondary font-monospace fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">
                                @(p.Brand?.Name ?? "MeiLing")
                            </span>
                            <h6 class="fw-bold text-dark text-truncate mb-2" style="font-size: 13.5px;" title="@p.Name">
                                <a href="@Url.Action("Details", "Product", new { id = p.Id })" class="text-decoration-none text-dark">
                                    @p.Name
                                </a>
                            </h6>

                            <!-- Ratings -->
                            <div class="text-warning mb-2" style="font-size: 11px;">
                                @{
                                    var avgRating = p.Reviews.Any() ? Math.Round(p.Reviews.Average(r => r.Rating ?? 5), 1) : 5.0;
                                    for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(avgRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                }
                                <span class="text-muted ms-1">(@(p.Reviews.Count()))</span>
                            </div>

                            <!-- Pricing -->
                            <div class="mt-auto pt-2">
                                @if (isDisc)
                                {
                                    <div class="text-danger fw-bold fs-6">@String.Format("{0:N0} đ", p.PromoPrice)</div>
                                    <div class="text-muted text-decoration-line-through small" style="font-size: 11.5px;">@String.Format("{0:N0} đ", p.Price)</div>
                                }
                                else
                                {
                                    <div class="text-danger fw-bold fs-6">@String.Format("{0:N0} đ", p.Price)</div>
                                }
                            </div>
                            
                            <!-- Add to cart direct link button -->
                            <a href="@Url.Action("Details", "Product", new { id = p.Id })" class="btn btn-sm btn-danger w-100 mt-3 text-white fw-bold py-2" style="background:#800020; border:none; font-size:12px;">
                                <i class="bi bi-cart-plus me-1"></i> Xem chi tiết
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted bg-white border rounded shadow-sm" style="border-radius:12px;">
            <i class="bi bi-heartbreak fs-1 text-danger"></i>
            <p class="mt-3 fs-5">Danh sách yêu thích của bạn đang trống.</p>
            <p class="text-muted small">Hãy thả tim các sản phẩm bạn thích khi mua sắm để lưu lại đây nhé!</p>
            <a asp-controller="Product" asp-action="List" class="btn btn-danger fw-bold mt-2" style="background:#800020; border:none; padding: 8px 24px;">
                Xem danh sách sản phẩm
            </a>
        </div>
    }
</div>

<script>
    function removeWishlistItem(productId) {
        if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi danh sách yêu thích?')) return;

        fetch('/Wishlist/ToggleWishlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `productId=${productId}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                // Remove item card from DOM
                const element = document.getElementById(`wish-item-${productId}`);
                if (element) {
                    element.style.transition = 'all 0.3s ease';
                    element.style.opacity = '0';
                    element.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        element.remove();
                        // Check if no items left and reload to show empty state
                        const cards = document.querySelectorAll('.wish-card');
                        if (cards.length === 0) {
                            window.location.reload();
                        }
                    }, 300);
                }
                
                if (typeof showCartToast === 'function') {
                    showCartToast(data.message);
                } else {
                    alert(data.message);
                }
            } else {
                alert(data.message || 'Lỗi khi xóa sản phẩm.');
            }
        })
        .catch(() => alert('Lỗi kết nối máy chủ.'));
    }
</script>
