@model IEnumerable<COSMETICC.Models.Review>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Đánh giá";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-card m-0">
        <div class="admin-card-title">
            <span><i class="bi bi-chat-left-text text-muted me-2"></i> Duyệt và Phản hồi Đánh giá từ khách hàng</span>
        </div>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Số sao</th>
                        <th style="width: 30%;">Nhận xét của khách</th>
                        <th>Trạng thái</th>
                        <th>Phản hồi của Admin</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var review in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(review.User?.FullName ?? review.GuestName ?? "Khách ẩn danh")</div>
                                    <small class="text-muted">@(review.User != null ? "@" + review.User.Username : "Khách vãng lai")</small>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 150px;" title="@review.Product?.Name">
                                        @(review.Product?.Name ?? "N/A")
                                    </div>
                                </td>
                                <td>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (review.Rating ?? 0))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </div>
                                    <small class="text-muted">@review.CreatedAt?.ToString("dd/MM/yy HH:mm")</small>
                                </td>
                                <td>
                                    <div class="text-wrap text-dark" style="font-size: 0.95rem;">@(review.Comment ?? "N/A")</div>
                                </td>
                                <td>
                                    @if (review.IsSpam)
                                    {
                                        <span class="badge bg-danger">Báo cáo Spam</span>
                                    }
                                    else if (review.IsApproved)
                                    {
                                        <span class="badge bg-success">Đã hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(review.ReplyText))
                                    {
                                        <div class="p-2 rounded bg-light border" style="font-size: 0.85rem; max-width: 250px;">
                                            <strong class="text-warning">MeiLing Admin:</strong>
                                            <span class="text-dark d-block">@review.ReplyText</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa phản hồi</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1" style="width: 130px;">
                                        
                                        @if (!review.IsApproved && !review.IsSpam)
                                        {
                                            <form asp-action="Approve" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@review.Id" />
                                                <button type="submit" class="btn-action btn-action-primary w-100 py-1" style="font-size: 0.8rem;">
                                                    <i class="bi bi-check-lg"></i> Duyệt hiện
                                                </button>
                                            </form>
                                        }

                                        @if (!review.IsSpam)
                                        {
                                            <form asp-action="Spam" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@review.Id" />
                                                <button type="submit" class="btn-action btn-action-danger w-100 py-1" style="font-size: 0.8rem;">
                                                    <i class="bi bi-shield-slash"></i> Báo Spam
                                                </button>
                                            </form>
                                        }

                                        <!-- Reply Trigger Button -->
                                        <button type="button" class="btn-action btn-action-outline w-100 py-1" style="font-size: 0.8rem;" data-bs-toggle="modal" data-bs-target="#replyModal-@review.Id">
                                            <i class="bi bi-reply"></i> Phản hồi
                                        </button>

                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@review.Id" />
                                            <button type="submit" class="btn-action btn-action-danger w-100 py-1" style="font-size: 0.8rem; background: rgba(220, 53, 69, 0.05);">
                                                <i class="bi bi-trash"></i> Xóa bỏ
                                            </button>
                                        </form>

                                    </div>

                                    <!-- Reply Modal -->
                                    <div class="modal fade" id="replyModal-@review.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Phản hồi bình luận: @(review.User?.FullName ?? review.User?.Username)</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Reply" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@review.Id" />
                                                    <div class="modal-body text-start">
                                                        <div class="mb-3 p-3 bg-light rounded text-dark">
                                                            <strong>Nội dung đánh giá:</strong>
                                                            <p class="mb-0 mt-1 italic">"@review.Comment"</p>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label">Phản hồi của cửa hàng</label>
                                                            <textarea name="replyText" class="form-control-admin" rows="4" required placeholder="Cảm ơn bạn đã phản hồi, MeiLing Shop xin ghi nhận...">@review.ReplyText</textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn-action btn-action-outline" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn-action btn-action-primary">Lưu phản hồi</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">Chưa nhận được phản hồi đánh giá nào từ khách hàng</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
