@model List<COSMETICC.Models.ReturnRequest>
@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Đổi / Trả Hàng (RMA)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-arrow-return-left text-danger me-2"></i>Quản Lý Yêu Cầu Đổi / Trả Hàng (RMA)</h3>
            <p class="text-muted small">Duyệt các yêu cầu hoàn tiền & trả hàng từ khách hàng, tự động hoàn trả số lượng vào tồn kho.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Yêu Cầu</th>
                        <th>Mã Đơn Hàng</th>
                        <th>Khách Hàng</th>
                        <th>Lý Do Trả Hàng</th>
                        <th>Ảnh Bằng Chứng</th>
                        <th>Số Tiền Hoàn</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Gửi</th>
                        <th class="text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            <tr>
                                <td><strong class="text-dark">#RMA-@req.Id</strong></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@(req.Order?.OrderCode ?? $"#ORD-{req.OrderId}")</span></td>
                                <td>
                                    <div class="fw-bold">@(req.User?.FullName ?? req.User?.Username ?? "Khách hàng")</div>
                                    <div class="small text-muted">@req.User?.Email</div>
                                </td>
                                <td style="max-width: 250px;">
                                    <span class="small text-dark text-break">@req.Reason</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(req.ImageUrl))
                                    {
                                        <a href="@req.ImageUrl" target="_blank">
                                            <img src="@req.ImageUrl" alt="Proof" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có</span>
                                    }
                                </td>
                                <td><strong class="text-danger">@req.RefundAmount.ToString("N0")đ</strong></td>
                                <td>
                                    @if (req.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Chờ duyệt</span>
                                    }
                                    else if (req.Status == "Approved")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đã duyệt & Hoàn kho</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Từ chối</span>
                                    }
                                </td>
                                <td><span class="small text-muted">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></td>
                                <td class="text-end">
                                    @if (req.Status == "Pending")
                                    {
                                        <form asp-action="Approve" method="post" class="d-inline mb-1">
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <button type="submit" class="btn btn-sm btn-success fw-bold px-3 me-1" onclick="return confirm('Duyệt trả hàng và hoàn số lượng tồn kho?')">
                                                <i class="bi bi-check-lg"></i> Duyệt
                                            </button>
                                        </form>
                                        <form asp-action="Reject" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3" onclick="return confirm('Từ chối yêu cầu này?')">
                                                <i class="bi bi-x-lg"></i> Từ chối
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">Đã xử lý</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có yêu cầu trả hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
