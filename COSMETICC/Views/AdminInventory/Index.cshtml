@model IEnumerable<COSMETICC.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Tồn kho";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Near Expiry Warning Alert -->
    @if (ViewBag.ExpiringBatchesCount > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-exclamation-octagon-fill text-warning fs-5 me-2"></i>
                Cảnh báo hạn sử dụng: Hiện tại có <strong>@ViewBag.ExpiringBatchesCount</strong> lô sản phẩm sắp hết hạn sử dụng trong vòng 60 ngày!
            </div>
            <a asp-action="Batches" class="btn btn-sm btn-outline-warning text-dark fw-bold">
                <i class="bi bi-calendar-range me-1"></i> Xem lô hết hạn
            </a>
        </div>
    }

    <div class="admin-card m-0">
        <div class="admin-card-title">
            <span><i class="bi bi-boxes text-muted me-2"></i> Số lượng hàng tồn trong kho</span>
            <div class="d-flex gap-2">
                <a asp-action="Batches" class="btn-action btn-action-outline text-success" style="border-color:#2ecc71;">
                    <i class="bi bi-calendar3-range me-1"></i> Quản lý Lô & HSD
                </a>
                <button type="button" class="btn btn-warning btn-sm fw-bold px-3 text-white d-flex align-items-center gap-1" style="background:#f39c12; border:none; height:34px;" onclick="openAuditModal()">
                    <i class="bi bi-qr-code-scan"></i> Kiểm kê QR/Barcode
                </button>
                <a asp-action="Logs" class="btn-action btn-action-outline">
                    <i class="bi bi-journal-text me-1"></i> Xem lịch sử Nhập/Xuất
                </a>
                <div style="width: 170px;">
                    <input type="text" id="invSearch" class="form-control-admin" placeholder="Tìm sản phẩm..." onkeyup="filterInventory()" />
                </div>
            </div>
        </div>

        <div class="admin-table-container">
            <table class="admin-table" id="invTable">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Mã SKU / Barcode</th>
                        <th>Nhãn mã</th>
                        <th>Lượng tồn</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            var isLowStock = (product.Stock ?? 0) <= 10;
                            var displayBarcode = string.IsNullOrEmpty(product.Barcode) ? $"PROD-{product.Id}" : product.Barcode;
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" alt="" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light text-center text-muted" style="width: 40px; height: 40px; line-height: 40px; font-size: 10px;">No Image</div>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@product.Name</td>
                                <td>
                                    <div><small class="text-primary fw-bold">SKU: @(product.SKU ?? "N/A")</small></div>
                                    <div><small class="text-muted">Barcode: @(product.Barcode ?? "Chưa gán")</small></div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showLabelModal('@product.Name', '@displayBarcode', '@product.SKU', '@product.Id')">
                                        <i class="bi bi-qr-code-scan me-1"></i> Xem mã vạch / QR
                                    </button>
                                </td>
                                <td class="fw-bold fs-6">@product.Stock</td>
                                <td>
                                    @if (product.Stock <= 0)
                                    {
                                        <span class="badge bg-danger text-white">Hết hàng</span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">Sắp hết hàng (&lt;= 10)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white">An toàn</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn-action btn-action-primary" data-bs-toggle="modal" data-bs-target="#manageModal-@product.Id">
                                        <i class="bi bi-arrow-left-right me-1"></i> Điều chỉnh kho
                                    </button>

                                    <!-- Quick Modal for each product -->
                                    <div class="modal fade" id="manageModal-@product.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-dark">Điều chỉnh kho: @product.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Manage" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@product.Id" />
                                                    <div class="modal-body text-start">
                                                        
                                                        <div class="mb-3 text-center">
                                                            <span class="text-muted">Tồn kho hiện tại:</span>
                                                            <h3 class="fw-bold text-dark mt-1">@product.Stock sản phẩm</h3>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="form-label fw-bold">Loại giao dịch</label>
                                                            <select name="type" class="form-control-admin" required>
                                                                <!option value="NHAP">Nhập hàng (+)</!option>
                                                                <!option value="XUAT" @(product.Stock <= 0 ? "disabled" : "")>Xuất hàng (-)</!option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="form-label fw-bold">Số lượng điều chỉnh</label>
                                                            <input type="number" name="quantity" class="form-control-admin" min="1" required />
                                                        </div>

                                                        <div class="form-group">
                                                            <label class="form-label fw-bold">Ghi chú giao dịch</label>
                                                            <textarea name="note" class="form-control-admin" placeholder="VD: Nhập thêm lô hàng tháng 7, xuất kho hủy hàng hỏng..." rows="3"></textarea>
                                                        </div>

                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn-action btn-action-outline" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn-action btn-action-primary">Xác nhận</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">Không tìm thấy sản phẩm nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal xem và in tem mã Barcode/QR -->
<div class="modal fade" id="labelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-upc-scan me-2 text-primary"></i>Tem nhãn kiểm kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div id="printArea" class="p-4 bg-white rounded shadow-sm d-inline-block border text-center" style="width: 100%; max-width: 320px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                    <div style="font-size: 14px; font-weight: bold; margin-bottom: 8px; color: #333; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" id="lblProdName">TÊN SẢN PHẨM</div>
                    <div style="font-size: 11px; margin-bottom: 12px; color: #666;" id="lblProdSKU">SKU: N/A</div>
                    
                    <div style="margin-bottom: 15px;">
                        <svg id="labelBarcode" style="max-width: 100%;"></svg>
                    </div>
                    
                    <div style="margin-bottom: 8px;">
                        <img id="labelQR" src="" style="width: 120px; height: 120px; border: 1px solid #eee; padding: 4px;" alt="QR Code" />
                    </div>
                    <div style="font-size: 10px; color: #999;">HỆ THỐNG KIỂM KHO COSMETIC</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-action btn-action-outline" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn-action btn-action-primary" onclick="printLabel()">
                    <i class="bi bi-printer me-1"></i> In tem mã nhãn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        function filterInventory() {
            const input = document.getElementById("invSearch");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("invTable");
            const tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                const tdName = tr[i].getElementsByTagName("td")[1];
                const tdSKU = tr[i].getElementsByTagName("td")[2];
                
                if (tdName || tdSKU) {
                    const textName = tdName.textContent || tdName.innerText;
                    const textSKU = tdSKU.textContent || tdSKU.innerText;
                    
                    if (textName.toLowerCase().indexOf(filter) > -1 || 
                        textSKU.toLowerCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        // Show Barcode / QR label modal
        function showLabelModal(name, barcode, sku, prodId) {
            document.getElementById("lblProdName").innerText = name;
            document.getElementById("lblProdSKU").innerText = "SKU: " + (sku || "N/A") + " | ID: " + prodId;
            
            // Generate barcode image inside svg via JsBarcode
            JsBarcode("#labelBarcode", barcode, {
                format: "CODE128",
                width: 2,
                height: 50,
                displayValue: true,
                fontSize: 12,
                margin: 0
            });
            
            // Generate QR code targeting product detail URL or ID
            const qrData = window.location.origin + "/Product/Details/" + prodId;
            document.getElementById("labelQR").src = "https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=" + encodeURIComponent(qrData);
            
            // Open Modal
            const myModal = new bootstrap.Modal(document.getElementById('labelModal'));
            myModal.show();
        }

        // Print label sticker functionality
        function printLabel() {
            const printContent = document.getElementById("printArea").outerHTML;
            const originalContent = document.body.innerHTML;
            
            // Open a clean printable print window
            const printWindow = window.open('', '_blank', 'height=500,width=400');
            printWindow.document.write('<html><head><title>Print Label</title>');
            printWindow.document.write('<style>body { display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; padding: 0; background-color: white; } @@media print { body { height: auto; } }</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(printContent);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            
            printWindow.focus();
            setTimeout(function() {
                printWindow.print();
                printWindow.close();
            }, 500);
        }

        // ================= BARCODE / QR SCAN WORKFLOW =================
        let html5QrcodeScanner = null;
        let selectedProductId = null;

        function openAuditModal() {
            const myModal = new bootstrap.Modal(document.getElementById('auditModal'));
            myModal.show();
            // Reset modal inputs
            document.getElementById('scanInput').value = '';
            document.getElementById('auditProductInfo').style.display = 'none';
            document.getElementById('auditAlert').className = 'alert alert-secondary py-2 small';
            document.getElementById('auditAlert').innerText = 'Vui lòng quét hoặc nhập mã để bắt đầu kiểm kê.';
            document.getElementById('auditAlert').style.display = 'block';
        }

        function startCameraScan() {
            if (html5QrcodeScanner) {
                stopCameraScan();
            }

            html5QrcodeScanner = new Html5Qrcode("reader");
            const config = { fps: 10, qrbox: { width: 180, height: 120 } };

            html5QrcodeScanner.start(
                { facingMode: "environment" },
                config,
                onScanSuccess,
                onScanFailure
            ).catch(err => {
                alert("Không thể khởi động camera: " + err);
            });
        }

        function stopCameraScan() {
            if (html5QrcodeScanner) {
                html5QrcodeScanner.stop().then(() => {
                    html5QrcodeScanner = null;
                    document.getElementById("reader").innerHTML = "";
                }).catch(err => console.log("Lỗi tắt camera: " + err));
            }
        }

        function onScanSuccess(decodedText, decodedResult) {
            console.log(`Scan result: ${decodedText}`, decodedResult);
            // Play success beep sound
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                osc.type = "sine";
                osc.frequency.setValueAtTime(800, audioCtx.currentTime);
                osc.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch(e){}

            document.getElementById('scanInput').value = decodedText;
            searchBarcode(decodedText);
            stopCameraScan();
        }

        function onScanFailure(error) {
            // Quiet fail - normal scanning loop
        }

        function handleManualScan(e) {
            if (e.key === 'Enter') {
                triggerScanSearch();
            }
        }

        function triggerScanSearch() {
            const val = document.getElementById('scanInput').value.trim();
            if (val) {
                searchBarcode(val);
            }
        }

        function searchBarcode(code) {
            const alertBox = document.getElementById('auditAlert');
            alertBox.className = 'alert alert-info py-2 small';
            alertBox.innerText = 'Đang tìm kiếm sản phẩm...';
            alertBox.style.display = 'block';
            document.getElementById('auditProductInfo').style.display = 'none';

            fetch(`/AdminInventory/GetProductByBarcode?barcode=${encodeURIComponent(code)}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        alertBox.style.display = 'none';
                        selectedProductId = data.product.id;

                        // Set info
                        document.getElementById('auditProdName').innerText = data.product.name;
                        document.getElementById('auditProdBrand').innerText = 'Hãng: ' + data.product.brandName;
                        document.getElementById('auditProdCodes').innerText = `SKU: ${data.product.sku || 'N/A'} | Barcode: ${data.product.barcode || 'N/A'}`;
                        document.getElementById('auditSystemQty').value = data.product.stock || 0;
                        document.getElementById('auditActualQty').value = data.product.stock || 0;
                        document.getElementById('auditNotes').value = '';

                        if (data.product.imageUrl) {
                            document.getElementById('auditProdImg').src = data.product.imageUrl;
                            document.getElementById('auditProdImg').style.display = 'block';
                        } else {
                            document.getElementById('auditProdImg').style.display = 'none';
                        }

                        // Load active batches text
                        let batchHtml = "";
                        if (data.batches && data.batches.length > 0) {
                            data.batches.forEach(b => {
                                batchHtml += `<div class="d-flex justify-content-between border-bottom py-1">
                                    <span>Lô: <strong>${b.batchNumber}</strong> (HSD: ${b.expiryDate})</span>
                                    <span class="badge bg-secondary">${b.quantity} sản phẩm</span>
                                </div>`;
                            });
                        } else {
                            batchHtml = '<span class="text-danger">Không tìm thấy lô hàng nào còn tồn kho.</span>';
                        }
                        document.getElementById('auditBatchesArea').innerHTML = batchHtml;

                        document.getElementById('auditProductInfo').style.display = 'block';
                    } else {
                        alertBox.className = 'alert alert-danger py-2 small';
                        alertBox.innerText = data.message || 'Lỗi tìm kiếm sản phẩm.';
                    }
                })
                .catch(() => {
                    alertBox.className = 'alert alert-danger py-2 small';
                    alertBox.innerText = 'Lỗi kết nối máy chủ.';
                });
        }

        function submitStockAudit() {
            if (!selectedProductId) return;

            const actualQty = parseInt(document.getElementById('auditActualQty').value);
            const note = document.getElementById('auditNotes').value.trim();

            if (isNaN(actualQty) || actualQty < 0) {
                alert('Số lượng thực tế không hợp lệ!');
                return;
            }

            fetch('/AdminInventory/AuditStock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${selectedProductId}&actualQty=${actualQty}&note=${encodeURIComponent(note)}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    // Reload page to refresh quantities in main table
                    window.location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra.');
                }
            })
            .catch(() => alert('Lỗi kết nối máy chủ.'));
        }
    </script>

    <!-- Barcode / QR Audit Modal -->
    <div class="modal fade" id="auditModal" tabindex="-1" aria-labelledby="auditModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; overflow: hidden;">
                <!-- Header -->
                <div style="background: #800020; color: white; padding: 16px 20px;" class="d-flex align-items-center justify-content-between">
                    <h5 class="modal-title fw-bold m-0" id="auditModalLabel"><i class="bi bi-qr-code-scan me-2"></i>Kiểm kê & Điều chỉnh kho nhanh bằng QR/Barcode</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="stopCameraScan()"></button>
                </div>
                
                <div class="modal-body p-4">
                    <div class="row g-3">
                        
                        <!-- Left: Camera scan scanner & Manual barcode inputs -->
                        <div class="col-md-5 border-end pe-3">
                            <div class="fw-bold mb-2 text-dark">Bước 1: Quét mã hoặc Nhập mã</div>
                            
                            <!-- Manual Entry -->
                            <div class="mb-3">
                                <label class="form-label small text-muted">Nhập mã Barcode hoặc SKU sản phẩm:</label>
                                <div class="input-group">
                                    <input type="text" id="scanInput" class="form-control" placeholder="Ví dụ: SP001, 893..." onkeyup="handleManualScan(event)" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="triggerScanSearch()">Tìm</button>
                                </div>
                            </div>

                            <!-- Camera Scan Frame -->
                            <div class="p-2 border rounded text-center bg-light" style="position: relative;">
                                <div class="small fw-bold text-secondary mb-2"><i class="bi bi-camera-fill me-1"></i>Camera quét trực tiếp</div>
                                <div id="reader" style="width: 100%; min-height: 180px; background: #000; border-radius: 6px; overflow: hidden;"></div>
                                
                                <div class="d-flex gap-2 justify-content-center mt-2">
                                    <button type="button" class="btn btn-sm btn-success px-3 fw-bold" onclick="startCameraScan()">Bật Cam</button>
                                    <button type="button" class="btn btn-sm btn-danger px-3 fw-bold" onclick="stopCameraScan()">Tắt Cam</button>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Product Audit Detail and Form Adjustment -->
                        <div class="col-md-7 ps-3">
                            <div class="fw-bold mb-2 text-dark">Bước 2: Xác nhận và Điều chỉnh tồn thực tế</div>
                            
                            <!-- Alert message container -->
                            <div id="auditAlert" class="alert alert-secondary py-2 small" style="display: block;">
                                Vui lòng quét hoặc nhập mã để bắt đầu kiểm kê.
                            </div>

                            <!-- Product detail box (hidden initially) -->
                            <div id="auditProductInfo" style="display: none;">
                                <div class="p-3 border rounded bg-light mb-3 d-flex align-items-center gap-3">
                                    <img id="auditProdImg" src="" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1" id="auditProdName">Tên sản phẩm</h6>
                                        <div class="small text-muted" id="auditProdBrand">Thương hiệu</div>
                                        <div class="small text-secondary font-monospace" id="auditProdCodes">SKU / Barcode</div>
                                    </div>
                                </div>

                                <!-- List of active batches -->
                                <div class="mb-3">
                                    <div class="small fw-bold text-dark mb-1">Các lô hàng hiện tại:</div>
                                    <div id="auditBatchesArea" class="small text-muted">Không có lô hàng nào.</div>
                                </div>

                                <!-- Adjustment Form -->
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold text-dark">Số lượng hệ thống:</label>
                                        <input type="text" id="auditSystemQty" class="form-control" disabled style="background:#e9ecef; font-weight:bold;" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold text-dark">Số lượng đếm thực tế:</label>
                                        <input type="number" id="auditActualQty" class="form-control" style="font-weight:bold; border-color:#f39c12;" min="0" required />
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <label class="form-label small fw-bold text-dark">Ghi chú kiểm kê:</label>
                                    <textarea id="auditNotes" class="form-control" rows="2" placeholder="Ví dụ: Thừa/thiếu do thất thoát, hàng lỗi..."></textarea>
                                </div>

                                <button type="button" class="btn btn-warning w-100 mt-3 text-white fw-bold" style="background:#800020; border:none; height:40px;" onclick="submitStockAudit()">
                                    <i class="bi bi-check-lg me-1"></i> Xác nhận & Cập nhật số lượng
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Html5Qrcode Library -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
}
