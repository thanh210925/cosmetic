@model COSMETICC.Models.FlashSale

@{
    ViewData["Title"] = "Tạo chương trình Flash Sale";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var products = ViewBag.Products as IEnumerable<dynamic>;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-lightning-fill text-warning me-2"></i>Tạo chương trình Flash Sale Mới</h2>
            <p class="text-muted mb-0">Thiết lập khung giờ vàng và chọn các sản phẩm giảm giá giới hạn số lượng.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="Create" method="post" id="flashSaleForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="row g-4">
            <!-- Campaign Info -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin chương trình</h5>
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tên chương trình Flash Sale <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="VD: Flash Sale Giờ Vàng 12h-14h" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartTime" class="form-label fw-bold">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="StartTime" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndTime" class="form-label fw-bold">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                        <label class="form-check-label fw-bold" for="IsActive">Kích hoạt ngay chương trình này</label>
                    </div>

                    <hr />

                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Lưu & Kích hoạt Flash Sale
                    </button>
                </div>
            </div>

            <!-- Product Selection & Sale Allocation -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-box-seam text-warning me-2"></i>Chọn Sản Phẩm & Cấu Hình Giá Sale</h5>
                        <input type="text" id="searchProductInput" class="form-control form-control-sm w-50" placeholder="🔍 Tìm kiếm sản phẩm..." onkeyup="filterProducts()" />
                    </div>

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i> Nhập giá Flash Sale và <strong>Số lượng mở bán (QuantiyForSale)</strong>. Khi khách hàng mua hết số lượng này, sản phẩm sẽ <strong>tự động tắt Flash Sale</strong> và trở về giá gốc.
                    </div>

                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="productSelectTable">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="40" class="text-center">Chọn</th>
                                    <th>Sản phẩm</th>
                                    <th>Giá gốc</th>
                                    <th>Tồn kho</th>
                                    <th width="150">Giá Flash Sale (VNĐ)</th>
                                    <th width="120">Số lượng Sale</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (products != null)
                                {
                                    foreach (var p in products)
                                    {
                                        <tr class="product-row" data-name="@p.Name.ToLower()">
                                            <td class="text-center">
                                                <input type="checkbox" class="form-check-input product-check" name="productIds" value="@p.Id" onchange="toggleProductRow(this)" />
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                                    {
                                                        <img src="@p.ImageUrl" width="40" height="40" class="rounded object-fit-cover" />
                                                    }
                                                    <div>
                                                        <div class="fw-bold text-dark small" style="max-width: 220px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">@p.Name</div>
                                                        <small class="text-muted">ID: #@p.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted text-decoration-line-through original-price" data-price="@p.Price">
                                                @string.Format("{0:N0}", p.Price) đ
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@p.Stock</span>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm discount-price-input" name="discountPrices" value="@((decimal)p.Price * 0.8m)" min="1" step="1000" disabled required />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm qty-input" name="quantityForSales" value="10" min="1" max="@p.Stock" disabled required />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function filterProducts() {
            var input = document.getElementById('searchProductInput').value.toLowerCase();
            var rows = document.querySelectorAll('.product-row');
            rows.forEach(function (row) {
                var name = row.getAttribute('data-name');
                if (name.includes(input)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function toggleProductRow(checkbox) {
            var row = checkbox.closest('tr');
            var priceInput = row.querySelector('.discount-price-input');
            var qtyInput = row.querySelector('.qty-input');

            if (checkbox.checked) {
                priceInput.removeAttribute('disabled');
                qtyInput.removeAttribute('disabled');
                row.classList.add('table-warning');
            } else {
                priceInput.setAttribute('disabled', 'disabled');
                qtyInput.setAttribute('disabled', 'disabled');
                row.classList.remove('table-warning');
            }
        }
    </script>
}
