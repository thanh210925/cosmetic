@model COSMETICC.Models.User

@{
    ViewData["Title"] = "Trang cá nhân";
}

<div class="container mt-5">
    <div class="card shadow p-4" style="max-width:500px; margin:auto;">

        <h3 class="text-center mb-4">👤 Trang cá nhân</h3>

        <div class="mb-2">
            <strong>Họ tên:</strong> @Model.FullName
        </div>

        <div class="mb-2">
            <strong>Email:</strong> @Model.Email
        </div>

        <div class="mb-2">
            <strong>SĐT:</strong> @Model.Phone
        </div>

        <div class="mb-2">
            <strong>Username:</strong> @Model.Username
        </div>

        <div class="mb-3">
            <strong>Ngày tạo:</strong> @Model.CreatedAt
        </div>

        <div class="text-center">
            <a class="btn btn-dark" asp-action="EditProfile">Cập nhật</a>
        </div>

    </div>
</div>