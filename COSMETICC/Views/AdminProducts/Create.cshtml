@model COSMETICC.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    
    <div class="mb-4">
        <a asp-action="Index" class="btn-action btn-action-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="admin-card m-0">
        <div class="admin-card-title pb-3 border-bottom">
            <span><i class="bi bi-plus-circle text-muted me-2"></i> Nhập thông tin sản phẩm mới</span>
        </div>

        <form asp-action="Create" method="post" class="py-3">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <div class="row">
                <!-- Left Column: Content details -->
                <div class="col-md-7 border-end">
                    
                    <div class="form-group mb-3">
                        <label asp-for="Name">Tên sản phẩm</label>
                        <input asp-for="Name" id="prodName" class="form-control-admin" placeholder="VD: Son lì MeiLing Matte Lip,..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Slug">Đường dẫn thân thiện (Slug)</label>
                        <input asp-for="Slug" id="prodSlug" class="form-control-admin" placeholder="VD: son-li-meiling-matte-lip" required />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control-admin" rows="5" placeholder="Thông tin chi tiết sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Ingredient">Thành phần chi tiết</label>
                        <textarea asp-for="Ingredient" class="form-control-admin" rows="4" placeholder="Danh sách các thành phần hoạt chất..."></textarea>
                        <span asp-validation-for="Ingredient" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="VideoUrl">Link Video Review (Youtube/URL)</label>
                        <input asp-for="VideoUrl" class="form-control-admin" placeholder="VD: https://youtube.com/watch?v=..." />
                        <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Tags">Tags sản phẩm (phân cách bằng dấu phẩy)</label>
                        <input asp-for="Tags" class="form-control-admin" placeholder="VD: sonli, trangdiem, duongmoi..." />
                        <span asp-validation-for="Tags" class="text-danger small"></span>
                    </div>

                </div>

                <!-- Right Column: Meta details and attributes -->
                <div class="col-md-5 ps-4">
                    
                    <div class="row">
                        <div class="col-6 form-group mb-3">
                            <label asp-for="CategoryId">Danh mục</label>
                            <select asp-for="CategoryId" class="form-control-admin" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var item in ViewBag.Categories)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-6 form-group mb-3">
                            <label asp-for="BrandId">Thương hiệu</label>
                            <select asp-for="BrandId" class="form-control-admin">
                                <option value="">-- Chọn thương hiệu --</option>
                                @foreach (var item in ViewBag.Brands)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 form-group mb-3">
                            <label asp-for="Price">Giá bán niêm yết (đ)</label>
                            <input asp-for="Price" type="number" class="form-control-admin" min="0" placeholder="Giá bán chính thức" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-6 form-group mb-3">
                            <label asp-for="PromoPrice">Giá khuyến mãi (đ)</label>
                            <input asp-for="PromoPrice" type="number" class="form-control-admin" min="0" placeholder="Giá ưu đãi (nếu có)" />
                            <span asp-validation-for="PromoPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 form-group mb-3">
                            <label asp-for="Stock">Số lượng nhập kho</label>
                            <input asp-for="Stock" type="number" class="form-control-admin" min="0" placeholder="Tồn kho ban đầu" required />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-6 form-group mb-3">
                            <label asp-for="ExpiryDate">Hạn sử dụng (Expiry Date)</label>
                            <input asp-for="ExpiryDate" type="date" class="form-control-admin" />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 form-group mb-3">
                            <label asp-for="SKU">Mã SKU</label>
                            <input asp-for="SKU" class="form-control-admin" placeholder="VD: MEILING-LIP-01" />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>

                        <div class="col-6 form-group mb-3">
                            <label asp-for="Barcode">Mã vạch (Barcode)</label>
                            <input asp-for="Barcode" class="form-control-admin" placeholder="VD: 8936000000000" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ImageUrl">Ảnh đại diện sản phẩm (URL)</label>
                        <input asp-for="ImageUrl" id="mainImageInput" class="form-control-admin" placeholder="VD: https://example.com/sp.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        <div class="mt-2" id="mainImagePreviewWrap" style="display:none;">
                            <img id="mainImagePreview" src="" class="rounded" style="max-height:100px; border:1px solid #ddd; padding:4px;" />
                        </div>
                    </div>

                    <!-- Gallery notice -->
                    <div class="p-3 mb-3 rounded" style="background:#fff8e1; border:1px dashed #f0a500; font-size:13px;">
                        <i class="bi bi-images text-warning me-2"></i>
                        <strong>Ảnh phụ sản phẩm (Gallery):</strong> Sau khi lưu sản phẩm, hãy vào trang <strong>Chỉnh sửa</strong> để thêm thêm nhiều ảnh phụ từ gallery. Ảnh thứ 2 sẽ hiển thị khi khách hover vào card sản phẩm.
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SkinType">Loại da phù hợp</label>
                        <input asp-for="SkinType" class="form-control-admin" placeholder="VD: Mọi loại da, Da dầu mụn, Da nhạy cảm..." />
                        <span asp-validation-for="SkinType" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4 d-flex gap-4">
                        <label class="form-check-label d-flex align-items-center gap-2">
                            <input asp-for="IsVegan" type="checkbox" style="width: 18px; height: 18px;" />
                            Sản phẩm thuần chay (Vegan)
                        </label>
                        
                        <label class="form-check-label d-flex align-items-center gap-2">
                            <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px;" />
                            Hiển thị trên web (Active)
                        </label>
                    </div>

                </div>
            </div>

            <!-- Full-width SEO Settings -->
            <div class="mt-4 p-4 rounded bg-light" style="border: 1px dashed var(--admin-border-color);">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-search text-muted me-2"></i>Cấu hình SEO Tối ưu hóa</h5>
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="MetaTitle">Tiêu đề SEO (Meta Title)</label>
                        <input asp-for="MetaTitle" class="form-control-admin" placeholder="VD: Mua Son Lì MeiLing Matte Lip Chính Hãng Giá Tốt" />
                        <span asp-validation-for="MetaTitle" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="MetaKeywords">Từ khóa SEO (Meta Keywords)</label>
                        <input asp-for="MetaKeywords" class="form-control-admin" placeholder="VD: son li, son meiling, my pham thuan chay" />
                        <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                    </div>
                    <div class="col-12 form-group mb-3">
                        <label asp-for="MetaDescription">Mô tả SEO (Meta Description)</label>
                        <textarea asp-for="MetaDescription" class="form-control-admin" rows="3" placeholder="Đoạn mô tả ngắn hiển thị trên kết quả tìm kiếm Google (tối ưu nhất từ 150-160 ký tự)..."></textarea>
                        <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn-action btn-action-primary px-5 py-2">
                    Lưu sản phẩm
                </button>
                <a asp-action="Index" class="btn-action btn-action-outline px-4 py-2">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <style>
        .note-editor {
            border-radius: 6px !important;
            border-color: #cbd5e1 !important;
            background-color: #ffffff;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function() {
            $('textarea[name="Description"]').summernote({
                placeholder: 'Nhập mô tả sản phẩm và chèn ảnh tại đây...',
                tabsize: 2,
                height: 250,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });
        });

        // Auto Slug Generation
        document.getElementById("prodName").addEventListener("input", function() {
            let name = this.value;
            let slug = name.toLowerCase()
                .replace(/á|à|ả|ã|ạ|ă|ắ|ằ|ẳ|ẵ|ặ|â|ấ|ầ|ẩ|ẫ|ậ/g, 'a')
                .replace(/é|è|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ/g, 'e')
                .replace(/í|ì|ỉ|ĩ|ị/g, 'i')
                .replace(/ó|ò|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ/g, 'o')
                .replace(/ú|ù|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự/g, 'u')
                .replace(/ý|ỳ|ỷ|ỹ|ỵ/g, 'y')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9 -]/g, '') // remove invalid chars
                .replace(/\s+/g, '-')        // replace spaces with -
                .replace(/-+/g, '-');        // collapse dashes
            
            document.getElementById("prodSlug").value = slug;
        });

        // Live preview main image
        document.getElementById('mainImageInput').addEventListener('input', function() {
            const url = this.value.trim();
            const preview = document.getElementById('mainImagePreview');
            const wrap = document.getElementById('mainImagePreviewWrap');
            if (url) {
                preview.src = url;
                wrap.style.display = 'block';
            } else {
                wrap.style.display = 'none';
            }
        });
    </script>
}
