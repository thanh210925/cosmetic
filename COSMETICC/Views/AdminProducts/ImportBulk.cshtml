@model List<COSMETICC.Models.Product>

@{
    ViewData["Title"] = "Nhập Sản Phẩm Hàng Loạt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<COSMETICC.Models.Category> ?? new();
    var brands = ViewBag.Brands as List<COSMETICC.Models.Brand> ?? new();
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="@Url.Action("Index", "AdminProducts")" class="text-decoration-none text-muted small">← Quay lại danh sách</a>
            <h2 class="fw-bold text-dark mb-1 mt-2">📥 Nhập Sản Phẩm Hàng Loạt (Excel Copy-Paste)</h2>
            <p class="text-muted small mb-0">Sao chép dữ liệu từ bảng Excel rồi dán vào đây để tạo nhanh hàng chục sản phẩm mới</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 small shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Vui lòng sửa các lỗi nhập liệu bên dưới trước khi xác nhận lưu.
            <div asp-validation-summary="All" class="mt-2 text-danger"></div>
        </div>
    }

    <!-- Bước 1: Copy Paste -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" id="step1Card">
        <div class="card-header bg-light border-0 py-3">
            <h5 class="card-title fw-bold text-dark mb-0 fs-6">Bước 1: Dán dữ liệu từ bảng Excel</h5>
        </div>
        <div class="card-body">
            <p class="small text-muted">
                Cấu trúc các cột trong file Excel cần copy theo đúng thứ tự sau (không copy dòng tiêu đề):<br/>
                <code>[Tên sản phẩm] &nbsp;&nbsp;|&nbsp;&nbsp; [Giá niêm yết (Số)] &nbsp;&nbsp;|&nbsp;&nbsp; [Giá khuyến mãi (Số/Trống)] &nbsp;&nbsp;|&nbsp;&nbsp; [SKU] &nbsp;&nbsp;|&nbsp;&nbsp; [Barcode] &nbsp;&nbsp;|&nbsp;&nbsp; [Thành phần]</code>
            </p>
            <textarea id="excelPasteArea" class="form-control font-monospace" rows="8" placeholder="Dán dữ liệu Excel tại đây (Ctrl+V)..." style="font-size: 13px;"></textarea>
            
            <div class="mt-3 row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Danh mục mặc định áp dụng chung</label>
                    <select id="defaultCategory" class="form-select">
                        @foreach(var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Thương hiệu mặc định áp dụng chung</label>
                    <select id="defaultBrand" class="form-select">
                        @foreach(var b in brands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
            </div>

            <button type="button" class="btn btn-primary mt-3 px-4" onclick="parseExcelData()">
                <i class="bi bi-gear-fill me-1"></i> Xử lý và kiểm tra dữ liệu →
            </button>
        </div>
    </div>

    <!-- Bước 2: Preview & Submit -->
    <form asp-action="ImportBulk" method="post" id="bulkForm" style="display:none;">
        @Html.AntiForgeryToken()
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-dark mb-0 fs-6">Bước 2: Xác nhận danh sách sản phẩm nhập vào</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetForm()">Làm lại</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 small" id="previewTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 25%;">Tên sản phẩm <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Giá niêm yết <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Giá bán KM</th>
                                <th style="width: 12%;">SKU <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Barcode</th>
                                <th style="width: 12%;">Danh mục</th>
                                <th style="width: 12%;">Thương hiệu</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>
                
                <div class="p-3 border-top d-flex justify-content-end gap-2 bg-light rounded-bottom-3">
                    <button type="button" class="btn btn-outline-secondary px-4" onclick="resetForm()">Hủy</button>
                    <button type="submit" class="btn btn-success px-5 fw-bold"><i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu Hàng Loạt Vào Hệ Thống</button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function parseExcelData() {
        const pasteData = document.getElementById("excelPasteArea").value.trim();
        if (!pasteData) {
            alert("Vui lòng dán dữ liệu trước!");
            return;
        }

        const defaultCat = document.getElementById("defaultCategory").value;
        const defaultBrand = document.getElementById("defaultBrand").value;

        const rows = pasteData.split("\n");
        const tableBody = document.querySelector("#previewTable tbody");
        tableBody.innerHTML = "";

        let validCount = 0;

        rows.forEach((row, index) => {
            if (!row.trim()) return;

            // Excel columns are separated by tabs
            const cols = row.split("\t");
            if (cols.length < 2) return; // Must have at least Name and Price

            const name = cols[0] ? cols[0].trim() : "";
            const price = cols[1] ? parseFloat(cols[1].replace(/[^0-9.-]+/g,"")) : 0;
            const promoPrice = (cols[2] && cols[2].trim() !== "") ? parseFloat(cols[2].replace(/[^0-9.-]+/g,"")) : null;
            const sku = cols[3] ? cols[3].trim() : "SKU-" + Math.floor(Math.random() * 1000000);
            const barcode = cols[4] ? cols[4].trim() : "";
            const ingredient = cols[5] ? cols[5].trim() : "";

            // Build select options
            let catOptions = "";
            document.querySelectorAll("#defaultCategory option").forEach(opt => {
                catOptions += `<option value="${opt.value}" ${opt.value == defaultCat ? "selected" : ""}>${opt.text}</option>`;
            });

            let brandOptions = "";
            document.querySelectorAll("#defaultBrand option").forEach(opt => {
                brandOptions += `<option value="${opt.value}" ${opt.value == defaultBrand ? "selected" : ""}>${opt.text}</option>`;
            });

            const rowHtml = `
                <tr>
                    <td class="ps-3">
                        <input name="products[${validCount}].Name" type="text" class="form-control form-control-sm" value="${name}" required />
                        <input name="products[${validCount}].Ingredient" type="hidden" value="${ingredient}" />
                    </td>
                    <td>
                        <input name="products[${validCount}].Price" type="number" class="form-control form-control-sm" value="${price}" required min="0" />
                    </td>
                    <td>
                        <input name="products[${validCount}].PromoPrice" type="number" class="form-control form-control-sm" value="${promoPrice || ''}" min="0" />
                    </td>
                    <td>
                        <input name="products[${validCount}].SKU" type="text" class="form-control form-control-sm" value="${sku}" required />
                    </td>
                    <td>
                        <input name="products[${validCount}].Barcode" type="text" class="form-control form-control-sm" value="${barcode}" />
                    </td>
                    <td>
                        <select name="products[${validCount}].CategoryId" class="form-select form-select-sm">
                            ${catOptions}
                        </select>
                    </td>
                    <td>
                        <select name="products[${validCount}].BrandId" class="form-select form-select-sm">
                            ${brandOptions}
                        </select>
                    </td>
                </tr>
            `;

            tableBody.insertAdjacentHTML("beforeend", rowHtml);
            validCount++;
        });

        if (validCount > 0) {
            document.getElementById("step1Card").style.display = "none";
            document.getElementById("bulkForm").style.display = "block";
        } else {
            alert("Không tìm thấy dòng dữ liệu hợp lệ nào để xử lý.");
        }
    }

    function resetForm() {
        document.getElementById("excelPasteArea").value = "";
        document.getElementById("step1Card").style.display = "block";
        document.getElementById("bulkForm").style.display = "none";
    }
</script>
