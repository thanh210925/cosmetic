@model COSMETICC.Models.Admin

@{
    ViewData["Title"] = "Admin Register";
}

<div class="container d-flex justify-content-center align-items-center" style="height:90vh;">
    <div class="card shadow p-4" style="width:400px; border-radius:15px;">

        <h3 class="text-center mb-4">🛠️ Tạo Admin</h3>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-2">
                <input asp-for="FullName" class="form-control" placeholder="Họ tên" required />
            </div>

            <div class="mb-2">
                <input asp-for="Username" class="form-control" placeholder="Username" required />
            </div>

            <div class="mb-2">
                <input asp-for="Email" class="form-control" placeholder="Email (phải có 'ml')" required />
            </div>

            <div class="mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" required />
            </div>

            <button class="btn btn-dark w-100">Đăng ký</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3 text-center p-2">
                @ViewBag.Error
            </div>
        }

        <div class="text-center mt-3">
            <a asp-action="Login">Quay lại đăng nhập</a>
        </div>

    </div>
</div>