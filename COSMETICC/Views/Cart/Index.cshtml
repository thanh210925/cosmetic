@model COSMETICC.Models.Cart

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal totalCartAmount = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<div class="container py-5">
    <div class="row">
        <!-- Cart Items List (col-md-8) -->
        <div class="col-lg-8 mb-4">
            <div class="cart-card">
                <div class="cart-title d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <i class="bi bi-cart3 me-2 text-success"></i> Giỏ hàng của bạn
                    </div>
                    @if (Model.CartItems != null && Model.CartItems.Any())
                    {
                        <div class="form-check fs-6 fw-normal mb-0 me-2">
                            <input class="form-check-input" type="checkbox" id="selectAllCheck" checked onchange="toggleSelectAll(this)" style="cursor: pointer; transform: scale(1.15);" />
                            <label class="form-check-label text-dark fw-bold user-select-none" for="selectAllCheck" style="cursor: pointer;">
                                Chọn tất cả (<span id="totalCartItemCount">@Model.CartItems.Count</span>)
                            </label>
                        </div>
                    }
                </div>

                @if (Model.CartItems != null && Model.CartItems.Any())
                {
                    <div id="cartItemsList">
                        @{
                            var groupedCartItems = Model.CartItems
                                .GroupBy(ci => ci.Product.Brand != null ? ci.Product.Brand.Name : "Thương hiệu khác")
                                .ToList();
                        }
                        @foreach (var group in groupedCartItems)
                        {
                            <div class="brand-group-wrapper mb-4 p-3 bg-light rounded border border-light-subtle" id="brand-group-@group.Key.Replace(" ", "-")">
                                <h6 class="fw-bold mb-3 pb-2 border-bottom d-flex align-items-center text-dark" style="border-bottom: 2px solid var(--cart-green) !important;">
                                    <i class="bi bi-shop me-2 text-danger"></i>
                                    Hãng: @group.Key
                                </h6>
                                <div class="brand-items">
                                    @foreach (var item in group)
                                    {
                                        var price = item.Product.PromoPrice ?? item.Product.Price;
                                        var subtotal = price * (item.Quantity ?? 1);
                                        totalCartAmount += subtotal;

                                        <div class="cart-item-row" id="cart-item-row-@item.Id">
                                            <!-- Checkbox tick select -->
                                            <div class="pe-3 d-flex align-items-center">
                                                <input type="checkbox" class="cart-item-checkbox form-check-input" data-id="@item.Id" value="@item.Id" checked onchange="recalculateCart()" style="cursor: pointer; width: 20px; height: 20px; accent-color: var(--cart-green);" />
                                            </div>

                                            <!-- Image -->
                                            <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "https://placehold.co/100x100?text=No+Image" : item.Product.ImageUrl)" class="cart-item-img" alt="" />

                                            <!-- Details -->
                                            <div class="cart-item-details">
                                                <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="cart-item-name">@item.Product.Name</a>
                                                <div class="text-muted small mb-2"><i class="bi bi-calendar3 me-1"></i>Ngày thêm: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="cart-item-price-info">
                                                    <span class="cart-item-price" id="unit-price-@item.Id" data-price="@price">@String.Format("{0:N0} đ", price)</span>
                                                </div>
                                            </div>

                                            <!-- Quantity Controls -->
                                            <div class="qty-control">
                                                <button class="qty-btn" onclick="adjustQty(@item.Id, -1)">-</button>
                                                <input type="text" class="qty-input" id="qty-input-@item.Id" value="@item.Quantity" readonly />
                                                <button class="qty-btn" onclick="adjustQty(@item.Id, 1)">+</button>
                                            </div>

                                            <!-- Subtotal Price -->
                                            <div class="item-subtotal-price" id="subtotal-@item.Id">@String.Format("{0:N0} đ", subtotal)</div>

                                            <!-- Remove Button -->
                                            <button class="btn-remove-item" onclick="removeItem(@item.Id)" title="Xóa mặt hàng">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="emptyCartMessage">
                        <i class="bi bi-cart-x fs-1"></i>
                        <p class="mt-3">Giỏ hàng của bạn đang trống.</p>
                        <a href="@Url.Action("List", "Product")" class="btn btn-sm btn-success px-4 py-2 mt-2" style="background-color: var(--cart-green);">Mua sắm ngay</a>
                    </div>
                }
            </div>
        </div>

        <!-- Checkout Summary (col-md-4) -->
        <div class="col-lg-4">
            <div class="summary-card">
                <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-receipt me-2"></i>Tóm tắt đơn hàng</h5>
                
                <div class="summary-row">
                    <span>Tạm tính (<span id="selectedCountText">0</span> sản phẩm)</span>
                    <span id="summarySubtotal" data-total="@totalCartAmount">@String.Format("{0:N0} đ", totalCartAmount)</span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span class="text-success fw-bold">Miễn phí</span>
                </div>
                <div class="summary-row total">
                    <span>Tổng thanh toán</span>
                    <span id="summaryTotal" class="text-danger">@String.Format("{0:N0} đ", totalCartAmount)</span>
                </div>

                <a href="@Url.Action("Checkout", "Cart")" id="checkoutBtn" class="btn-checkout text-center text-white text-decoration-none d-block w-100 py-3 rounded-3 fw-bold" style="background: linear-gradient(135deg, #9b0022, #c70d3a); box-shadow: 0 4px 15px rgba(155,0,34,0.3);">
                    <i class="bi bi-bag-check-fill me-2"></i> TIẾN HÀNH ĐẶT HÀNG
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        recalculateCart();
    });

    function toggleSelectAll(masterCheckbox) {
        const checkboxes = document.querySelectorAll('.cart-item-checkbox');
        checkboxes.forEach(cb => {
            cb.checked = masterCheckbox.checked;
        });
        recalculateCart();
    }

    // Adjust quantity via AJAX
    function adjustQty(cartItemId, delta) {
        const input = document.getElementById("qty-input-" + cartItemId);
        let newQty = parseInt(input.value) + delta;
        if (newQty <= 0) {
            removeItem(cartItemId);
            return;
        }

        fetch(`/Cart/UpdateQuantity?cartItemId=${cartItemId}&quantity=${newQty}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    input.value = newQty;
                    recalculateRow(cartItemId, newQty);
                } else {
                    alert(data.message || 'Lỗi khi cập nhật số lượng.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Lỗi kết nối máy chủ.');
            });
    }

    // Recalculate row price and summary
    function recalculateRow(cartItemId, qty) {
        const unitPriceSpan = document.getElementById("unit-price-" + cartItemId);
        const unitPrice = parseFloat(unitPriceSpan.getAttribute("data-price"));
        const subtotalSpan = document.getElementById("subtotal-" + cartItemId);
        
        const newSubtotal = unitPrice * qty;
        subtotalSpan.innerText = new Intl.NumberFormat('vi-VN').format(newSubtotal) + " đ";
        
        recalculateCart();
    }

    // Recalculate the entire cart total dynamically based ONLY on checked items
    function recalculateCart() {
        let total = 0;
        let selectedIds = [];
        let totalItems = 0;
        let checkedItemsCount = 0;

        const allCheckboxes = document.querySelectorAll('.cart-item-checkbox');
        totalItems = allCheckboxes.length;

        allCheckboxes.forEach(cb => {
            if (cb.checked) {
                checkedItemsCount++;
                const id = cb.getAttribute('data-id');
                selectedIds.push(id);

                const unitPriceSpan = document.getElementById("unit-price-" + id);
                const unitPrice = parseFloat(unitPriceSpan.getAttribute("data-price"));
                const qty = parseInt(document.getElementById("qty-input-" + id).value) || 1;
                total += unitPrice * qty;
            }
        });

        // Sync Select All checkbox state
        const selectAllCheck = document.getElementById("selectAllCheck");
        if (selectAllCheck) {
            selectAllCheck.checked = (totalItems > 0 && checkedItemsCount === totalItems);
        }

        const countSpan = document.getElementById("selectedCountText");
        if (countSpan) countSpan.innerText = checkedItemsCount;

        const subtotalSpan = document.getElementById("summarySubtotal");
        const totalSpan = document.getElementById("summaryTotal");
        if (subtotalSpan) subtotalSpan.innerText = new Intl.NumberFormat('vi-VN').format(total) + " đ";
        if (totalSpan) totalSpan.innerText = new Intl.NumberFormat('vi-VN').format(total) + " đ";
        
        const checkoutBtn = document.getElementById("checkoutBtn");
        if (checkoutBtn) {
            if (totalItems === 0) {
                checkoutBtn.classList.add("disabled");
                checkoutBtn.style.backgroundColor = "#cbd5e1";
                checkoutBtn.style.background = "#cbd5e1";
                checkoutBtn.style.cursor = "not-allowed";
                checkoutBtn.style.pointerEvents = "none";
                checkoutBtn.innerHTML = '<i class="bi bi-cart-x me-2"></i> GIỎ HÀNG TRỐNG';
                checkoutBtn.removeAttribute("href");
            } else if (checkedItemsCount === 0) {
                checkoutBtn.classList.add("disabled");
                checkoutBtn.style.backgroundColor = "#cbd5e1";
                checkoutBtn.style.background = "#cbd5e1";
                checkoutBtn.style.cursor = "not-allowed";
                checkoutBtn.style.pointerEvents = "none";
                checkoutBtn.innerHTML = '<i class="bi bi-exclamation-circle me-2"></i> CHỌN SẢN PHẨM ĐỂ THANH TOÁN';
                checkoutBtn.removeAttribute("href");
            } else {
                checkoutBtn.classList.remove("disabled");
                checkoutBtn.style.background = "linear-gradient(135deg, #9b0022, #c70d3a)";
                checkoutBtn.style.cursor = "pointer";
                checkoutBtn.style.pointerEvents = "auto";
                checkoutBtn.innerHTML = `<i class="bi bi-bag-check-fill me-2"></i> TIẾN HÀNH ĐẶT HÀNG (${checkedItemsCount})`;
                checkoutBtn.setAttribute("href", `/Cart/Checkout?selectedIds=${selectedIds.join(',')}`);
            }
        }

        if (totalItems === 0) {
            const list = document.getElementById("cartItemsList");
            if (list) list.remove();
            
            const card = document.querySelector(".cart-card");
            if (card && !document.getElementById("emptyCartMessage")) {
                const emptyMsg = `
                    <div class="text-center py-5 text-muted" id="emptyCartMessage">
                        <i class="bi bi-cart-x fs-1"></i>
                        <p class="mt-3">Giỏ hàng của bạn đang trống.</p>
                        <a href="/Product/List" class="btn btn-sm btn-success px-4 py-2 mt-2" style="background-color: var(--cart-green);">Mua sắm ngay</a>
                    </div>
                `;
                card.innerHTML = emptyMsg;
            }
        }
    }

    // Remove item via AJAX
    function removeItem(cartItemId) {
        if (!confirm("Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?")) return;

        fetch(`/Cart/RemoveItem?cartItemId=${cartItemId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById("cart-item-row-" + cartItemId);
                    if (row) {
                        row.style.transform = "scale(0.9)";
                        row.style.opacity = "0";
                        row.style.transition = "all 0.3s ease";
                        setTimeout(() => {
                            const brandGroup = row.closest('.brand-group-wrapper');
                            row.remove();
                            if (brandGroup && brandGroup.querySelectorAll('.cart-item-row').length === 0) {
                                brandGroup.remove();
                            }
                            recalculateCart();
                        }, 300);
                    }
                } else {
                    alert(data.message || 'Lỗi khi xóa sản phẩm.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Lỗi kết nối máy chủ.');
            });
    }
</script>
