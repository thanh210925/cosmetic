@model COSMETICC.Models.Cart

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal totalCartAmount = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    :root {
        --cart-green: #800020;
        --cart-border: #e2e8f0;
    }

    body {
        background-color: #f8fafc;
    }

    .cart-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--cart-border);
        padding: 25px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .cart-title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--cart-border);
        padding-bottom: 15px;
    }

    .cart-item-row {
        display: flex;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid var(--cart-border);
        transition: background-color 0.2s ease;
    }

    .cart-item-row:last-child {
        border-bottom: none;
    }

    .cart-item-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--cart-border);
        padding: 5px;
        background: white;
    }

    .cart-item-details {
        flex-grow: 1;
        padding-left: 20px;
    }

    .cart-item-brand {
        font-size: 11px;
        font-weight: bold;
        color: var(--cart-green);
        text-transform: uppercase;
    }

    .cart-item-name {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        text-decoration: none;
        display: block;
        margin-bottom: 5px;
    }

    .cart-item-name:hover {
        color: var(--cart-green);
    }

    .cart-item-price-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cart-item-price {
        font-size: 15px;
        font-weight: bold;
        color: #e02424;
    }

    .qty-control {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 4px;
        overflow: hidden;
        width: 110px;
    }

    .qty-btn {
        background: #f1f5f9;
        border: none;
        width: 32px;
        height: 32px;
        font-size: 16px;
        font-weight: bold;
        color: #475569;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
    }

    .qty-btn:hover {
        background: #e2e8f0;
    }

    .qty-input {
        width: 46px;
        height: 32px;
        text-align: center;
        border: none;
        border-left: 1px solid #ccc;
        border-right: 1px solid #ccc;
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
    }

    .qty-input:focus {
        outline: none;
    }

    .item-subtotal-price {
        font-size: 16px;
        font-weight: 700;
        color: #e02424;
        min-width: 120px;
        text-align: right;
    }

    .btn-remove-item {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        font-size: 18px;
        margin-left: 15px;
        transition: color 0.2s ease;
    }

    .btn-remove-item:hover {
        color: #ef4444;
    }

    /* Summary Panel */
    .summary-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--cart-border);
        padding: 25px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        position: sticky;
        top: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        font-size: 15px;
        color: #475569;
    }

    .summary-row.total {
        border-top: 1px dashed var(--cart-border);
        padding-top: 15px;
        font-size: 18px;
        font-weight: bold;
        color: #1e293b;
    }

    .btn-checkout {
        background-color: var(--cart-green);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px;
        width: 100%;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        margin-top: 15px;
    }

    .btn-checkout:hover {
        background-color: #03522c;
        color: white;
    }
</style>

<div class="container py-5">
    <div class="row">
        <!-- Cart Items List (col-md-8) -->
        <div class="col-lg-8 mb-4">
            <div class="cart-card">
                <div class="cart-title">
                    <i class="bi bi-cart3 me-2 text-success"></i> Giỏ hàng của bạn
                </div>

                @if (Model.CartItems != null && Model.CartItems.Any())
                {
                    <div id="cartItemsList">
                        @{
                            var groupedCartItems = Model.CartItems
                                .GroupBy(ci => ci.Product.Brand != null ? ci.Product.Brand.Name : "Thương hiệu khác")
                                .ToList();
                        }
                        @foreach (var group in groupedCartItems)
                        {
                            <div class="brand-group-wrapper mb-4 p-3 bg-light rounded border border-light-subtle" id="brand-group-@group.Key.Replace(" ", "-")">
                                <h6 class="fw-bold mb-3 pb-2 border-bottom d-flex align-items-center text-dark" style="border-bottom: 2px solid var(--cart-green) !important;">
                                    <i class="bi bi-shop me-2 text-danger"></i>
                                    Hãng: @group.Key
                                </h6>
                                <div class="brand-items">
                                    @foreach (var item in group)
                                    {
                                        var price = item.Product.PromoPrice ?? item.Product.Price;
                                        var subtotal = price * (item.Quantity ?? 1);
                                        totalCartAmount += subtotal;

                                        <div class="cart-item-row" id="cart-item-row-@item.Id">
                                            <!-- Image -->
                                            <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "https://placehold.co/100x100?text=No+Image" : item.Product.ImageUrl)" class="cart-item-img" alt="" />

                                            <!-- Details -->
                                            <div class="cart-item-details">
                                                <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="cart-item-name">@item.Product.Name</a>
                                                <div class="text-muted small mb-2"><i class="bi bi-calendar3 me-1"></i>Ngày thêm: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="cart-item-price-info">
                                                    <span class="cart-item-price" id="unit-price-@item.Id" data-price="@price">@String.Format("{0:N0} đ", price)</span>
                                                </div>
                                            </div>

                                            <!-- Quantity Controls -->
                                            <div class="qty-control">
                                                <button class="qty-btn" onclick="adjustQty(@item.Id, -1)">-</button>
                                                <input type="text" class="qty-input" id="qty-input-@item.Id" value="@item.Quantity" readonly />
                                                <button class="qty-btn" onclick="adjustQty(@item.Id, 1)">+</button>
                                            </div>

                                            <!-- Subtotal Price -->
                                            <div class="item-subtotal-price" id="subtotal-@item.Id">@String.Format("{0:N0} đ", subtotal)</div>

                                            <!-- Remove Button -->
                                            <button class="btn-remove-item" onclick="removeItem(@item.Id)" title="Xóa mặt hàng">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="emptyCartMessage">
                        <i class="bi bi-cart-x fs-1"></i>
                        <p class="mt-3">Giỏ hàng của bạn đang trống.</p>
                        <a href="@Url.Action("List", "Product")" class="btn btn-sm btn-success px-4 py-2 mt-2" style="background-color: var(--cart-green);">Mua sắm ngay</a>
                    </div>
                }
            </div>
        </div>

        <!-- Checkout Summary (col-md-4) -->
        <div class="col-lg-4">
            <div class="summary-card">
                <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-receipt me-2"></i>Tóm tắt đơn hàng</h5>
                
                <div class="summary-row">
                    <span>Tạm tính</span>
                    <span id="summarySubtotal" data-total="@totalCartAmount">@String.Format("{0:N0} đ", totalCartAmount)</span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span class="text-success fw-bold">Miễn phí</span>
                </div>
                <div class="summary-row total">
                    <span>Tổng thanh toán</span>
                    <span id="summaryTotal" class="text-danger">@String.Format("{0:N0} đ", totalCartAmount)</span>
                </div>

                @if (totalCartAmount > 0)
                {
                    <form asp-controller="Payment" asp-action="CreatePayment" method="post">
                        <button type="submit" class="btn-checkout" id="checkoutBtn" style="width: 100%;">
                            <i class="bi bi-credit-card-2-front-fill"></i> Thanh toán qua VNPay
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn-checkout" id="checkoutBtn" disabled style="background-color: #cbd5e1; cursor: not-allowed;">
                        Giỏ hàng trống
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Adjust quantity via AJAX
    function adjustQty(cartItemId, delta) {
        const input = document.getElementById("qty-input-" + cartItemId);
        let newQty = parseInt(input.value) + delta;
        if (newQty <= 0) {
            removeItem(cartItemId);
            return;
        }

        fetch(`/Cart/UpdateQuantity?cartItemId=${cartItemId}&quantity=${newQty}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    input.value = newQty;
                    recalculateRow(cartItemId, newQty);
                } else {
                    alert(data.message || 'Lỗi khi cập nhật số lượng.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Lỗi kết nối máy chủ.');
            });
    }

    // Recalculate row price and summary
    function recalculateRow(cartItemId, qty) {
        const unitPriceSpan = document.getElementById("unit-price-" + cartItemId);
        const unitPrice = parseFloat(unitPriceSpan.getAttribute("data-price"));
        const subtotalSpan = document.getElementById("subtotal-" + cartItemId);
        
        const newSubtotal = unitPrice * qty;
        subtotalSpan.innerText = new Intl.NumberFormat('vi-VN').format(newSubtotal) + " đ";
        
        recalculateCart();
    }

    // Recalculate the entire cart total dynamically
    function recalculateCart() {
        let total = 0;
        document.querySelectorAll('.cart-item-row').forEach(row => {
            const id = row.id.split('-').pop();
            const unitPriceSpan = document.getElementById("unit-price-" + id);
            const unitPrice = parseFloat(unitPriceSpan.getAttribute("data-price"));
            const qty = parseInt(document.getElementById("qty-input-" + id).value);
            total += unitPrice * qty;
        });

        const subtotalSpan = document.getElementById("summarySubtotal");
        const totalSpan = document.getElementById("summaryTotal");
        
        subtotalSpan.innerText = new Intl.NumberFormat('vi-VN').format(total) + " đ";
        totalSpan.innerText = new Intl.NumberFormat('vi-VN').format(total) + " đ";
        
        const checkoutBtn = document.getElementById("checkoutBtn");
        if (total <= 0) {
            if (checkoutBtn) {
                checkoutBtn.setAttribute("disabled", "disabled");
                checkoutBtn.style.backgroundColor = "#cbd5e1";
                checkoutBtn.style.cursor = "not-allowed";
                checkoutBtn.innerText = "Giỏ hàng trống";
                checkoutBtn.removeAttribute("onclick");
            }
            // Show empty cart message
            const list = document.getElementById("cartItemsList");
            if (list) list.remove();
            
            const card = document.querySelector(".cart-card");
            const emptyMsg = `
                <div class="text-center py-5 text-muted" id="emptyCartMessage">
                    <i class="bi bi-cart-x fs-1"></i>
                    <p class="mt-3">Giỏ hàng của bạn đang trống.</p>
                    <a href="/Product/List" class="btn btn-sm btn-success px-4 py-2 mt-2" style="background-color: var(--cart-green);">Mua sắm ngay</a>
                </div>
            `;
            card.innerHTML += emptyMsg;
        }
    }

    // Remove item via AJAX
    function removeItem(cartItemId) {
        if (!confirm("Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?")) return;

        fetch(`/Cart/RemoveItem?cartItemId=${cartItemId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById("cart-item-row-" + cartItemId);
                    if (row) {
                        row.style.transform = "scale(0.9)";
                        row.style.opacity = "0";
                        row.style.transition = "all 0.3s ease";
                        setTimeout(() => {
                            const brandGroup = row.closest('.brand-group-wrapper');
                            row.remove();
                            if (brandGroup && brandGroup.querySelectorAll('.cart-item-row').length === 0) {
                                brandGroup.remove();
                            }
                            recalculateCart();
                        }, 300);
                    }
                } else {
                    alert(data.message || 'Lỗi khi xóa sản phẩm.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Lỗi kết nối máy chủ.');
            });
    }


</script>
