@model IEnumerable<COSMETICC.Models.Discount>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Voucher";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-card m-0">
        <div class="admin-card-title">
            <span><i class="bi bi-ticket-perforated text-muted me-2"></i> Danh sách mã giảm giá khuyến mãi</span>
            <a asp-action="Create" class="btn-action btn-action-primary">
                <i class="bi bi-plus-lg me-1"></i> Tạo mới Voucher
            </a>
        </div>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã Voucher</th>
                        <th>Phần trăm giảm</th>
                        <th>Thời gian áp dụng</th>
                        <th>Lượt sử dụng</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var voucher in Model)
                        {
                            var now = DateTime.Now;
                            var notStarted = voucher.StartDate != null && voucher.StartDate > now;
                            var isExpired = voucher.ExpiryDate != null && voucher.ExpiryDate < now;
                            var limitReached = voucher.UsageLimit != null && voucher.UsedCount >= voucher.UsageLimit;

                            var statusClass = "bg-success";
                            var statusText = "Đang hoạt động";
                            
                            if (isExpired)
                            {
                                statusClass = "bg-secondary";
                                statusText = "Hết hạn";
                            }
                            else if (notStarted)
                            {
                                statusClass = "bg-warning text-dark";
                                statusText = "Chờ kích hoạt";
                            }
                            else if (limitReached)
                            {
                                statusClass = "bg-danger";
                                statusText = "Hết lượt dùng";
                            }

                            <tr>
                                <td class="fw-bold">
                                    <span class="bg-light border border-dashed px-2 py-1 text-monospace rounded">
                                        @voucher.Code
                                    </span>
                                </td>
                                <td class="fw-bold">@voucher.Percentage%</td>
                                <td>
                                    <div><small class="text-muted">Bắt đầu:</small> @(voucher.StartDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
                                    <div><small class="text-muted">Kết thúc:</small> @(voucher.ExpiryDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@voucher.UsedCount / @(voucher.UsageLimit?.ToString() ?? "∞")</div>
                                    <small class="text-muted">lượt đã dùng</small>
                                </td>
                                <td>
                                    <span class="badge @statusClass">@statusText</span>
                                </td>
                                <td>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa voucher này không?');">
                                        <input type="hidden" name="id" value="@voucher.Id" />
                                        <button type="submit" class="btn-action btn-action-danger">
                                            <i class="bi bi-trash-fill"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">Chưa có mã giảm giá nào được thiết lập</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
