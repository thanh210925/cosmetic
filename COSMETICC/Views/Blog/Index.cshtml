@model IEnumerable<COSMETICC.Models.BlogPost>
@{
    ViewData["Title"] = "Tin tức & Bí quyết làm đẹp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var recentPosts = (List<COSMETICC.Models.BlogPost>)ViewBag.RecentPosts;
    var uniqueTags = (List<string>)ViewBag.UniqueTags;
}

<style>
    body {
        background-color: #f8fafc;
    }
    .blog-header {
        background: linear-gradient(135deg, #800020 0%, #4a0012 100%);
        color: white;
        padding: 50px 0;
        text-align: center;
        margin-bottom: 40px;
    }
    .blog-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #edf2f7;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .blog-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(128,0,32,0.1);
        border-color: #800020;
    }
    .blog-card-img {
        height: 200px;
        object-fit: cover;
        width: 100%;
        transition: all 0.3s;
    }
    .widget-title {
        font-weight: 700;
        color: #800020;
        border-bottom: 2px solid #800020;
        padding-bottom: 8px;
        margin-bottom: 15px;
    }
    .tag-badge {
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .tag-badge:hover, .tag-badge.active {
        background: #800020;
        color: white;
    }
</style>

<div class="blog-header">
    <div class="container">
        <h1 class="fw-bold display-5">CẨM NANG LÀM ĐẸP MEILING</h1>
        <p class="lead opacity-75 mb-0">Chia sẻ bí quyết chăm sóc da, đánh giá mỹ phẩm và phong cách sống thuần chay</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        
        <!-- Left: Blog List Grid -->
        <div class="col-lg-8">
            @if (ViewBag.CurrentTag != null)
            {
                <div class="alert alert-light border mb-4 d-flex align-items-center justify-content-between">
                    <span>Đang lọc theo thẻ tag: <strong class="text-danger">#@ViewBag.CurrentTag</strong></span>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            }

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var post in Model)
                    {
                        <div class="col-md-6">
                            <div class="blog-card">
                                <a href="@Url.Action("Details", "Blog", new { slug = post.Slug })">
                                    <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://placehold.co/400x200?text=MeiLing+Skincare" : post.ImageUrl)" class="blog-card-img" alt="@post.Title" />
                                </a>
                                <div class="p-4 d-flex flex-column flex-grow-1 text-start">
                                    <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i>@post.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <h5 class="fw-bold mb-2">
                                        <a href="@Url.Action("Details", "Blog", new { slug = post.Slug })" class="text-decoration-none text-dark hover-danger" style="line-height: 1.4;">
                                            @post.Title
                                        </a>
                                    </h5>
                                    <p class="text-secondary small mb-4 flex-grow-1">@post.Summary</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <a href="@Url.Action("Details", "Blog", new { slug = post.Slug })" class="fw-bold text-decoration-none small text-danger" style="color: #800020;">
                                            Đọc tiếp <i class="bi bi-arrow-right"></i>
                                        </a>
                                        @if (!string.IsNullOrEmpty(post.Tags))
                                        {
                                            <span class="badge bg-light text-muted"># @post.Tags.Split(',')[0].Trim()</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 text-muted bg-white border rounded">
                        <i class="bi bi-journal-x fs-1"></i>
                        <p class="mt-3 fs-5">Hiện tại chưa có bài viết nào được xuất bản.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Sidebar Widget -->
        <div class="col-lg-4 ps-lg-4 mt-5 mt-lg-0 text-start">
            
            <!-- Widget 1: Popular Tags -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:12px; background:white;">
                <h5 class="widget-title">Thẻ chủ đề</h5>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (uniqueTags != null && uniqueTags.Any())
                    {
                        foreach (var tag in uniqueTags)
                        {
                            var isActive = tag.Equals(ViewBag.CurrentTag, StringComparison.OrdinalIgnoreCase) ? "active" : "";
                            <a href="@Url.Action("Index", "Blog", new { tag = tag })" class="tag-badge @isActive">#@tag</a>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">Đang cập nhật...</span>
                    }
                </div>
            </div>

            <!-- Widget 2: Recent Posts -->
            <div class="card border-0 shadow-sm p-4" style="border-radius:12px; background:white;">
                <h5 class="widget-title">Bài viết mới nhất</h5>
                <div class="mt-3 d-flex flex-column gap-3">
                    @if (recentPosts != null && recentPosts.Any())
                    {
                        foreach (var rp in recentPosts)
                        {
                            <div class="d-flex gap-3 align-items-center">
                                <img src="@(string.IsNullOrEmpty(rp.ImageUrl) ? "https://placehold.co/80x80?text=skincare" : rp.ImageUrl)" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                <div>
                                    <h6 class="fw-bold mb-1" style="font-size: 13.5px; line-height: 1.3;">
                                        <a href="@Url.Action("Details", "Blog", new { slug = rp.Slug })" class="text-decoration-none text-dark hover-danger">@rp.Title</a>
                                    </h6>
                                    <small class="text-muted" style="font-size: 11px;">@rp.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">Đang cập nhật...</span>
                    }
                </div>
            </div>

        </div>

    </div>
</div>

<style>
    .hover-danger:hover {
        color: #800020 !important;
    }
</style>
