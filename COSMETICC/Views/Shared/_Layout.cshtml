    <meta property="og:site_name" content="MeiLing Cosmetics" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "MeiLing Cosmetics | Mỹ Phẩm Chính Hãng High-End")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Cung cấp mỹ phẩm chính hãng cao cấp, dưỡng da & trang điểm từ các thương hiệu uy tín thế giới.")" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop" />

    <!-- Twitter Cards SEO -->
    <meta name="twitter:card" content="summary_large_image" />
