    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Mỹ phẩm chính hãng cao cấp - Giao hàng nhanh 2H.")" />

    <!-- Schema.org JSON-LD Structured Data for Google Search Rich Snippets -->
