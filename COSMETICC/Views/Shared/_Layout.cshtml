@{
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var _action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var _sort = Context.Request.Query["sort"].ToString();
    var _hasPromo = Context.Request.Query["hasPromo"].ToString();
    // Helper: returns "active-menu-item" when conditions match
    string MenuActive(string ctrl, string action, string sort = "", string promo = "")
    {
        if (_ctrl != ctrl || _action != action) return "";
        if (!string.IsNullOrEmpty(sort) && _sort != sort) return "";
        if (!string.IsNullOrEmpty(promo) && _hasPromo != promo) return "";
        if (string.IsNullOrEmpty(sort) && string.IsNullOrEmpty(promo))
        {
            // General link: only match if current URL has no filter params
            if (!string.IsNullOrEmpty(_sort) || !string.IsNullOrEmpty(_hasPromo)) return "";
        }
        return "active-menu-item";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
