                       style="flex-grow: 1; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 20px; font-size: 13px; outline: none; transition: border 0.2s;" required />
                <button type="submit" style="background: #800020; color: white; border: none; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;">
                    <i class="bi bi-send-fill" style="font-size: 14px;"></i>
                </button>
            </form>
        </div>
