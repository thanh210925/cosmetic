             role="alert" style="background:linear-gradient(135deg, #800020, #9b0022); border-radius:12px;">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" style="font-size:14px; font-weight:500;">
                    <i class="bi bi-cart-check-fill fs-5"></i>
                    <span id="cartToastMsg">Đã thêm vào giỏ hàng!</span>
