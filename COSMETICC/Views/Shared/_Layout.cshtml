        <button id="chatBubbleBtn" onclick="toggleChatWindow()" 
                style="background: #800020; color: white; border: none; width: 56px; height: 56px; border-radius: 50%; box-shadow: 0 4px 15px rgba(128,0,32,0.25); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; outline:none;">
            <i class="bi bi-chat-dots-fill" id="chatIcon" style="font-size: 24px;"></i>
        </button>

        <!-- Chat Window -->
        <div id="chatWindow" class="d-none" 
             style="position: absolute; bottom: 70px; right: 0; width: 330px; height: 425px; background: white; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid #eef0f3; display: flex; flex-direction: column; overflow: hidden; transition: all 0.3s;">
            <!-- Header -->
            <div style="background: #800020; color: white; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 10px; height: 10px; background: #2ecc71; border-radius: 50%; animation: pulseChat 1.5s infinite;"></div>
                    <span style="font-weight: 600; font-size: 14.5px;">Hỗ trợ trực tuyến MeiLing</span>
                </div>
                <button onclick="toggleChatWindow()" style="background: none; border: none; color: white; font-size: 18px; cursor: pointer; padding: 0; display:flex; align-items:center;">
                    <i class="bi bi-dash-lg"></i>
                </button>
            </div>
            
            <!-- Messages Area -->
            <div id="chatMessagesArea" style="flex-grow: 1; padding: 15px; overflow-y: auto; background: #f8fafc; display: flex; flex-direction: column; gap: 10px; font-size: 13px; line-height:1.5;">
                <!-- Welcoming auto message -->
                <div class="d-flex gap-2 align-items-start">
                    <div style="background: #e2e8f0; color: #333; padding: 8px 12px; border-radius: 4px 12px 12px 12px; max-width: 85%;">
                        Xin chào! Cảm ơn bạn đã ghé thăm MeiLing. Bạn cần tư vấn về sản phẩm hay soi da có thể gửi tin nhắn tại đây nhé!
