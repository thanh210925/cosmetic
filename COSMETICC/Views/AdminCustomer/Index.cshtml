@model IEnumerable<COSMETICC.Models.User>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-card m-0">
        <div class="admin-card-title">
            <span><i class="bi bi-people text-muted me-2"></i> Danh sách Khách hàng hệ thống</span>
            
            <div style="width: 250px;">
                <input type="text" id="customerSearch" class="form-control-admin" placeholder="Tìm kiếm khách hàng..." onkeyup="filterCustomers()" />
            </div>
        </div>

        <div class="admin-table-container">
            <table class="admin-table" id="customersTable">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Thông tin liên hệ</th>
                        <th>Điểm tích lũy</th>
                        <th>Tổng chi tiêu</th>
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var customer in Model)
                        {
                            var totalSpent = customer.Orders?
                                .Where(o => o.Status == "Hoàn thành" || o.Status == "Đã giao")
                                .Sum(o => o.TotalAmount) ?? 0;
                            
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(customer.FullName ?? "N/A")</div>
                                    <small class="text-muted">@@@customer.Username</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1 small"></i> @(customer.Email ?? "N/A")</div>
                                    <div><i class="bi bi-phone me-1 small"></i> @(customer.Phone ?? "N/A")</div>
                                </td>
                                <td class="fw-bold text-warning">
                                    <i class="bi bi-star-fill me-1"></i> @customer.Points điểm
                                </td>
                                <td class="fw-bold text-dark">
                                    @String.Format("{0:N0} đ", totalSpent)
                                </td>
                                <td>@(customer.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>
                                    @if (customer.IsLocked)
                                    {
                                        <span class="badge bg-danger">Khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="History" asp-route-id="@customer.Id" class="btn-action btn-action-outline">
                                            <i class="bi bi-clock-history me-1"></i> Lịch sử mua
                                        </a>

                                        @if (customer.IsLocked)
                                        {
                                            <form asp-action="Unlock" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@customer.Id" />
                                                <button type="submit" class="btn-action btn-action-primary py-1 px-3">
                                                    <i class="bi bi-unlock-fill me-1"></i> Mở khóa
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Lock" method="post" onsubmit="return confirm('Bạn có chắc muốn khóa tài khoản khách hàng này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@customer.Id" />
                                                <button type="submit" class="btn-action btn-action-danger py-1 px-3">
                                                    <i class="bi bi-lock-fill me-1"></i> Khóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">Không tìm thấy khách hàng nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterCustomers() {
            const input = document.getElementById("customerSearch");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("customersTable");
            const tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                const tdName = tr[i].getElementsByTagName("td")[0];
                const tdContact = tr[i].getElementsByTagName("td")[1];
                
                if (tdName || tdContact) {
                    const textName = tdName.textContent || tdName.innerText;
                    const textContact = tdContact.textContent || tdContact.innerText;
                    
                    if (textName.toLowerCase().indexOf(filter) > -1 || 
                        textContact.toLowerCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}
