@{
    ViewData["Title"] = "Về chúng tôi - MeiLing Cosmetic";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<div class="container pb-5">
    
    <!-- Hero Header -->
    <div class="about-hero text-center">
        <h1 class="about-hero-title">MeiLing Cosmetic</h1>
        <p class="about-hero-subtitle" style="font-size: 20px; font-weight: 500;">
            Hành trình thấu hiểu làn da, kiến tạo sự tự tin và nâng niu vẻ đẹp rạng rỡ tự nhiên của riêng bạn.
        </p>
    </div>

    <div class="row">
        <!-- Left Content Column -->
        <div class="col-lg-8">
            
            <!-- Section 1: Thấu hiểu tâm lý và nỗi đau của khách hàng -->
            <div class="about-section">
                <h3 class="section-accent-title">Chúng tôi thấu hiểu nỗi lòng và làn da của bạn</h3>
                <p class="story-lead">
                    Có bao giờ bạn đứng trước gương, nhìn vào những đốm mụn viêm đỏ, những vết thâm sạm cứng đầu hay những nếp nhăn li ti bắt đầu xuất hiện, rồi thở dài tự hỏi: <em>"Làn da của mình đã từng khỏe mạnh biết bao, tại sao bây giờ lại trở nên nhạy cảm thế này?"</em>
                </p>
                <p class="story-paragraph">
                    Chúng tôi hiểu rằng, trong xã hội hiện đại, làn da không chỉ là một phần của cơ thể. Nó phản ánh trực tiếp sức khỏe, chế độ sinh hoạt, mức độ căng thẳng của bạn, và hơn hết, nó quyết định sự tự tin của bạn khi giao tiếp. Khi làn da gặp vấn đề, bạn không chỉ cảm thấy khó chịu về mặt vật lý, mà còn phải chịu đựng một áp lực tâm lý vô hình: ngại ngùng trước ánh nhìn của người khác, tự ti trong công việc và thậm chí là né tránh những ống kính máy ảnh.
                </p>
                <p class="story-paragraph">
                    Thấu hiểu sâu sắc nỗi lòng đó, chúng tôi sáng tạo nên <strong>MeiLing</strong> không đơn thuần như một cửa hàng thương mại mỹ phẩm. Chúng tôi định vị mình là người bạn đồng hành trung thực, người lắng nghe và gỡ rối mọi vấn đề về da của bạn. Chúng tôi tin rằng, không có làn da nào là "xấu xí" hay "vô phương cứu chữa", chỉ có những làn da đang bị tổn thương và chưa tìm được đúng phương pháp phục hồi phù hợp.
                </p>
                <p class="story-paragraph" style="font-weight: 600; color: var(--about-red);">
                    Mỹ phẩm đối với MeiLing không phải là lớp mặt nạ dày cộp để che giấu khuyết điểm bên ngoài, mà là nguồn dinh dưỡng tinh khiết giúp nuôi dưỡng làn da khỏe mạnh từ sâu bên trong tế bào gốc.
                </p>
            </div>

            <!-- Section 2: Câu chuyện thương hiệu chi tiết -->
            <div class="about-section">
                <h3 class="section-accent-title">Hành trình kiến tạo thương hiệu từ giấc mơ tử tế</h3>
                <p class="story-paragraph">
                    Hành trình của MeiLing bắt đầu cách đây nhiều năm, từ những trải nghiệm thực tế đầy đau xót của chính những người sáng lập. Chúng tôi đã từng chứng kiến những người thân yêu nhất của mình phải nhập viện điều trị da liễu dài ngày, gương mặt bị tàn phá nặng nề bởi kem trộn chứa corticoid, những sản phẩm lột tẩy cấp tốc trôi nổi gắn mác "gia truyền". Sự tàn nhẫn của những người bán hàng thiếu lương tâm đã cướp đi nhan sắc và niềm vui sống của biết bao phụ nữ và nam giới trẻ tuổi.
                </p>
                <p class="story-paragraph">
                    Giữa một thị trường mỹ phẩm vàng thau lẫn lộn tại Việt Nam, nơi hàng giả xách tay được bán tinh vi với mức giá như hàng thật, chúng tôi đã hạ quyết tâm: <strong>Phải xây dựng một thánh đường làm đẹp hoàn toàn tử tế và minh bạch.</strong>
                </p>
                <p class="story-paragraph">
                    Những ngày đầu thành lập, đội ngũ sáng lập của MeiLing đã trực tiếp bay sang Pháp, Hàn Quốc, Nhật Bản để gặp gỡ các đại diện hãng, tham quan các phòng thí nghiệm da liễu lớn. Chúng tôi kiên trì đàm phán từng hợp đồng phân phối chính ngạch, cam kết đầu tư hệ thống bảo quản đạt tiêu chuẩn quốc tế để các hãng tin tưởng giao phó sản phẩm. Chúng tôi chấp nhận biên lợi nhuận thấp hơn, thủ tục hải quan phức tạp hơn để mọi sản phẩm bán ra đều có đầy đủ hóa đơn VAT, tem phụ tiếng Việt và chứng từ nhập khẩu hợp pháp.
                </p>
            </div>

            <!-- Section 3: Quy trình tuyển chọn 5 bước chuẩn y khoa -->
            <div class="about-section bg-light">
                <h3 class="section-accent-title" style="color: #333;">Quy trình tuyển chọn sản phẩm 5 bước khắt khe</h3>
                <p class="story-paragraph">
                    Để một sản phẩm chính thức xuất hiện trên kệ hàng của MeiLing và được trao đến tay bạn, sản phẩm đó bắt buộc phải vượt qua quy trình kiểm duyệt 5 bước độc quyền của chúng tôi:
                </p>
                <ol style="font-size: 14.5px; line-height: 1.8; color: #555; padding-left: 20px;">
                    <li class="mb-2"><strong>Xác minh nguồn gốc pháp lý:</strong> Chỉ làm việc trực tiếp với văn phòng đại diện của hãng tại Việt Nam hoặc nhà nhập khẩu được hãng ủy quyền chính thức.</li>
                    <li class="mb-2"><strong>Phân tích bảng thành phần (Ingredients List):</strong> Đội ngũ dược sĩ của chúng tôi sẽ phân tích chi tiết hoạt chất. Loại bỏ ngay các sản phẩm chứa cồn khô nồng độ cao, parabens gây hại, hương liệu tổng hợp dễ kích ứng hoặc dầu khoáng gây bít tắc lỗ chân lông đối với dòng da mụn.</li>
                    <li class="mb-2"><strong>Thử nghiệm lâm sàng thực tế:</strong> Sản phẩm sẽ được gửi đến nhóm tình nguyện viên thử nghiệm trong vòng 30 ngày dưới sự theo dõi của chuyên gia để đánh giá hiệu quả thực tế trên nền da người Việt.</li>
                    <li class="mb-2"><strong>Đánh giá chứng nhận da liễu:</strong> Chỉ ưu tiên các dòng mỹ phẩm đạt chứng nhận Dermatologically Tested, Hypoallergenic (không gây dị ứng) hoặc Vegan (thuần chay bảo vệ môi trường).</li>
                    <li class="mb-0"><strong>Hệ thống lưu trữ tiêu chuẩn GSP:</strong> Toàn bộ hàng hóa được lưu kho lạnh kiểm soát nhiệt độ ổn định dưới 25°C để giữ nguyên hoạt tính sinh học của các dưỡng chất nhạy cảm như Vitamin C, Retinol...</li>
                </ol>
            </div>

            <!-- Section 4: Chăm sóc cá nhân hóa -->
            <div class="about-section">
                <h3 class="section-accent-title">Không có sản phẩm tốt nhất, chỉ có sản phẩm phù hợp nhất</h3>
                <p class="story-paragraph">
                    MeiLing hiểu rằng, mỗi làn da là độc bản giống như vân tay của bạn vậy. Một chai kem dưỡng ẩm giá 2 triệu đồng được khen ngợi hết lời trên mạng vẫn có thể khiến làn da dầu của bạn lên mụn ẩn chi chít nếu kết cấu của nó quá dày. Ngược lại, một sản phẩm bình dân giá 200.000 đ nếu chứa đúng hoạt chất phục hồi mà da bạn đang thiếu sẽ mang lại hiệu quả kỳ diệu.
                </p>
                <p class="story-paragraph">
                    Vì vậy, chúng tôi đã đầu tư xây dựng **Hệ thống phân loại và bộ lọc thông minh chuẩn Hasaki** trên website. Bạn có thể dễ dàng lọc sản phẩm theo đúng tình trạng da hiện tại của mình: da dầu mụn, da khô thiếu nước, da nhạy cảm kích ứng, da lão hóa... Chúng tôi mong muốn mỗi khách hàng khi mua sắm tại MeiLing đều trở thành một người tiêu dùng thông thái, hiểu rõ mình đang bôi gì lên mặt và tại sao lại bôi hoạt chất đó.
                </p>
            </div>

        </div>

        <!-- Right Sidebar Column -->
        <div class="col-lg-4">
            
            <!-- Side Stats Card -->
            <div class="about-section text-center">
                <h5 class="fw-bold mb-4 pb-2 border-bottom text-dark">MeiLing Qua Những Con Số</h5>
                
                <div class="stat-item border-bottom">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Chính hãng kiểm duyệt pháp lý</div>
                </div>
                
                <div class="stat-item border-bottom">
                    <div class="stat-number">50.000+</div>
                    <div class="stat-label">Khách hàng trao gửi niềm tin</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">24/7</div>
                    <div class="stat-label">Dược sĩ tư vấn chuyên sâu</div>
                </div>
            </div>

            <!-- Medical Standard Storage Card -->
            <div class="about-section" style="background-color: #fdf2f4; border-color: #ffd6db;">
                <h5 class="fw-bold mb-3" style="color: var(--about-red);"><i class="bi bi-snow text-danger me-2"></i>Bảo Quản Kho Lạnh Chuẩn GSP</h5>
                <p style="font-size: 13.5px; line-height: 1.6; color: #555; text-align: justify;">
                    Rất nhiều loại mỹ phẩm (đặc biệt là Vitamin C tinh khiết, Retinoids, Coenzyme Q10...) rất dễ bị oxy hóa, mất hoàn toàn tác dụng hoặc biến đổi chất độc hại khi tiếp xúc với nhiệt độ cao và ánh nắng trực tiếp tại khí hậu nhiệt đới Việt Nam. 
                </p>
                <p style="font-size: 13.5px; line-height: 1.6; color: #555; text-align: justify; margin-bottom: 0;">
                    Tại MeiLing, chúng tôi vận hành hệ thống kho chứa máy lạnh trung tâm hoạt động liên tục 24/7, duy trì độ ẩm dưới 60% và nhiệt độ luôn ở mức lý tưởng 18°C - 22°C. Hàng hóa vận chuyển từ kho đến tay bạn cũng được đóng gói chống sốc nhiệt chuyên dụng. Bạn có thể hoàn toàn yên tâm nhận về tay những giọt dưỡng chất tươi mới nhất!
                </p>
            </div>

            <!-- Golden Commitments Seal -->
            <div class="about-section bg-white">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-shield-check text-success me-2"></i>Cam Kết Vàng Bảo Vệ Bạn</h5>
                <ul class="list-unstyled mb-0" style="font-size: 13.5px; line-height: 1.8;">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                        <span><strong>Bồi hoàn gấp đôi:</strong> Bồi thường ngay 200% giá trị đơn hàng nếu khách hàng chứng minh được sản phẩm của MeiLing là hàng giả mạo.</span>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                        <span><strong>Được quyền kiểm tra:</strong> Quý khách luôn được mở hộp kiểm tra tem chống hàng giả, quét mã barcode/QR kiểm tra nguồn gốc trước khi thanh toán tiền cho shipper.</span>
                    </li>
                    <li class="d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                        <span><strong>Đồng hành kích ứng:</strong> Nếu da bạn không may xảy ra hiện tượng đỏ rát hay nổi mẩn, MeiLing sẽ chi trả toàn bộ chi phí khám da liễu và hoàn tiền sản phẩm cho bạn trong vòng 7 ngày đầu sử dụng.</span>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- Section 5: Ba trụ cột cốt lõi -->
    <h3 class="text-center fw-bold mt-5 mb-4 text-dark" style="font-size: 22px;">3 Giá Trị Cốt Lõi Tại MeiLing</h3>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="commitment-card text-center">
                <div class="commitment-icon"><i class="bi bi-award-fill"></i></div>
                <h4 class="commitment-title">100% Chính Hãng Ký Kết</h4>
                <p class="commitment-desc">
                    Tất cả các nhãn hàng có mặt tại MeiLing đều được nhập khẩu chính ngạch trực tiếp từ công ty mẹ, có tem chống hàng giả của Bộ Công An, hóa đơn chứng từ hải quan đầy đủ. Tuyệt đối không qua trung gian trôi nổi.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="commitment-card text-center">
                <div class="commitment-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                <h4 class="commitment-title">Y Khoa & Lành Tính</h4>
                <p class="commitment-desc">
                    Mỹ phẩm lành tính được khuyên dùng bởi các bác sĩ da liễu hàng đầu. Chúng tôi luôn ghi chú chi tiết bảng thành phần hóa học rõ ràng, minh bạch giúp bạn chủ động phòng ngừa các hoạt chất gây dị ứng cho da.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="commitment-card text-center">
                <div class="commitment-icon"><i class="bi bi-chat-heart-fill"></i></div>
                <h4 class="commitment-title">Cá Nhân Hóa Toàn Diện</h4>
                <p class="commitment-desc">
                    Trải nghiệm mua sắm thông thái với hệ thống phân loại loại da chuyên sâu. Các dược sĩ giàu kinh nghiệm của chúng tôi luôn sẵn sàng hỗ trợ soi da và tư vấn phác đồ Skincare miễn phí trọn đời cho bạn.
                </p>
            </div>
        </div>
    </div>

    <!-- Beautiful Quote Block -->
    <div class="emotional-quote-box text-center">
        <p class="emotional-quote">
            "Vẻ đẹp đích thực không nằm ở một làn da hoàn hảo không tì vết theo tiêu chuẩn của người khác, mà nằm ở sự khỏe mạnh, rạng rỡ và tình yêu bạn dành cho chính bản thân mình mỗi ngày."
        </p>
        <div class="emotional-quote-author">— Đội ngũ chuyên gia & sáng lập MeiLing Cosmetic</div>
    </div>

    <!-- Section 6: Lời cảm ơn và Kêu gọi hành động -->
    <div class="about-section text-center">
        <h3 class="section-accent-title d-inline-block pb-2 mb-4">Chúng tôi biết ơn sự hiện diện của bạn</h3>
        <p class="story-paragraph text-center mx-auto" style="max-width: 850px; font-size: 16px; line-height: 1.8; color: #555;">
            Làn da là tấm gương phản chiếu tâm hồn và sức khỏe của bạn. Nó bảo vệ bạn trước giông bão cuộc đời, và giờ là lúc bạn cần yêu thương và nâng niu lại người bạn trung thành ấy. Chúng tôi vô cùng hạnh phúc và trân trọng khi được bạn trao gửi niềm tin để MeiLing đồng hành cùng bạn trên con đường kiến tạo một làn da khỏe mạnh, căng tràn sức sống. Sự tự tin của bạn khi soi gương mỗi buổi sáng chính là động lực lớn nhất để MeiLing tiếp tục vững bước trên con đường tử tế này.
        </p>
        <div class="mt-5">
            <a asp-controller="Product" asp-action="List" class="btn btn-lg btn-danger px-5 py-3 fw-bold" style="background-color: var(--about-red); border: none; border-radius: 30px; box-shadow: 0 4px 15px rgba(128, 0, 32, 0.3);">
                <i class="bi bi-bag-heart-fill me-2"></i> Khám phá không gian mua sắm ngay
            </a>
        </div>
    </div>

</div>
