@{
    ViewData["Title"] = "Home Page";
}

<!-- Font Awesome -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- CSS -->
<link href="~/css/style.css" rel="stylesheet" />

<body>

    <!-- BANNER -->
    <section class="banner">

        <div class="banner-left">
            <img src="https://images.unsplash.com/photo-1526947425960-945c6e72858f?q=80&w=1200&auto=format&fit=crop" alt="">
        </div>

        <div class="banner-right">
            <h4>PHIÊN BẢN CẢI TIẾN</h4>

            <h1>
                Gel tắm bí đao
                sạch bã nhờn
            </h1>

            <p>
                Làm sạch sâu và hỗ trợ giảm mụn cơ thể.
            </p>

            <button>MUA NGAY</button>
        </div>

    </section>

    <!-- INTRO -->
    <section class="intro">

        <div class="intro-text">
            <h2>Tinh chất dưỡng Sen Hậu Giang</h2>

            <p>
                Giúp cấp ẩm và làm dịu làn da tự nhiên.
            </p>
        </div>

        <div class="intro-image">
            <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=1200&auto=format&fit=crop" alt="">
        </div>

    </section>

    <!-- BRAND -->
    <section class="brand">

        <div class="brand-content">
            <h2>Triết lý THƯƠNG HIỆU</h2>

            <p>
                Mỹ phẩm thuần chay dành cho người Việt.
            </p>

            <button>TÌM HIỂU THÊM</button>
        </div>

    </section>

    <!-- VEGAN -->
    <section class="vegan">

        <h1>THUẦN CHAY CHO NÉT ĐẸP THUẦN VIỆT</h1>

        <div class="vegan-list">

            <div class="vegan-item">
                <i class="fa-solid fa-leaf"></i>
                <h3>CRUELTY FREE</h3>
                <p>Không thử nghiệm trên động vật.</p>
            </div>

            <div class="vegan-item">
                <i class="fa-solid fa-seedling"></i>
                <h3>VEGAN</h3>
                <p>100% thành phần thuần chay.</p>
            </div>

            <div class="vegan-item">
                <i class="fa-solid fa-paw"></i>
                <h3>ANIMAL TEST FREE</h3>
                <p>Thân thiện với môi trường.</p>
            </div>

        </div>

    </section>

    <!-- PRODUCT -->
    <section class="products">

        <div class="section-title">
            <h2>Sản phẩm BÁN CHẠY</h2>
        </div>

        <div class="product-list">

            <div class="product-item">
                <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=1200&auto=format&fit=crop" alt="">

                <h3>Tinh chất sen</h3>

                <p>320.000đ</p>
            </div>

            <div class="product-item">
                <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop" alt="">

                <h3>Kem dưỡng nghệ</h3>

                <p>450.000đ</p>
            </div>

            <div class="product-item">
                <img src="https://images.unsplash.com/photo-1626784215021-2e39ccf971cd?q=80&w=1200&auto=format&fit=crop" alt="">

                <h3>Gel tắm bí đao</h3>

                <p>390.000đ</p>
            </div>

        </div>

    </section>

    <!-- GREEN BANNER -->
    <section class="green-banner">

        <div class="green-content">
            <h1>CÙNG MEILING SỐNG XANH MỖI NGÀY</h1>

            <button>TÌM HIỂU THÊM</button>
        </div>

    </section>

    <!-- BLOG -->
    <section class="blog">

        <div class="blog-title">
            <h2>Bài viết mới nhất</h2>
        </div>

        <div class="blog-list">

            <div class="blog-item">
                <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=1200&auto=format&fit=crop" alt="">

                <h3>Điểm xanh online</h3>

                <p>Sống xanh cùng MeiLing.</p>
            </div>

            <div class="blog-item">
                <img src="https://images.unsplash.com/photo-1526045478516-99145907023c?q=80&w=1200&auto=format&fit=crop" alt="">

                <h3>Thu hồi pin cũ</h3>

                <p>Chung tay bảo vệ môi trường.</p>
            </div>

        </div>
    </section>
    <!-- INSTAGRAM -->
    <section class="instagram">

        <h2></h2>

        <div class="instagram-list">

            <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop" alt="">

            <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=1200&auto=format&fit=crop" alt="">

            <img src="https://images.unsplash.com/photo-1626784215021-2e39ccf971cd?q=80&w=1200&auto=format&fit=crop" alt="">

            <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=1200&auto=format&fit=crop" alt="">

        </div>

    </section>
    <!-- FOOTER -->
</body>
