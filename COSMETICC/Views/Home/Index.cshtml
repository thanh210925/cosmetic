@model COSMETICC.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - MeiLing Cosmetics | Mỹ Phẩm Chính Hãng High-End";
    ViewData["MetaDescription"] = "MeiLing Cosmetics - Cung cấp mỹ phẩm chính hãng 100%, nước tẩy trang, sữa rửa mặt, serum phục hồi & son môi cao cấp. Giao hàng 2H toàn quốc.";
    ViewData["MetaKeywords"] = "mỹ phẩm chính hãng, chăm sóc da, serum b5, nước tẩy trang, sữa rửa mặt, son môi, kem chống nắng";
}

<!-- Semantic H1 for Search Engine Optimization -->
<h1 class="visually-hidden">MeiLing Cosmetics - Hệ Thống Mỹ Phẩm Chính Hãng High-End & Chăm Sóc Da Chuyên Sâu</h1>

<!-- Link Google Fonts & CSS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="~/css/home-luxury-red.css" asp-append-version="true" />



<div class="home-container">
    <!-- MAIN CENTERED CONTENT CONTAINER -->
    <div class="container home-inner-container pt-3 pb-5">
        <!-- TWO COLUMN PROMO BANNERS -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="promo-banner" style="background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('https://images.unsplash.com/photo-1501004318641-b39e6451bec6?q=80&w=500&auto=format&fit=crop');">
                    <div class="promo-content">
                        <h3>COMBO LÀM ĐẸP</h3>
                        <p>Mua nhiều - Tiết kiệm hơn. Trọn bộ dưỡng da chuyên sâu được đề xuất bởi chuyên gia.</p>
                        <a href="/Product/List?categoryId=1" class="promo-btn">KHÁM PHÁ NGAY <i class="fa-solid fa-angle-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="promo-banner" style="background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=500&auto=format&fit=crop');">
                    <div class="promo-content">
                        <h3>BẢO VỆ LÀN DA DƯỚI NẮNG HÈ</h3>
                        <p>Chọn ngay kem chống nắng phù hợp với mọi làn da khô, dầu mụn.</p>
                        <a href="/Product/List?search=Chống+nắng" class="promo-btn">XEM NGAY <i class="fa-solid fa-angle-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <!-- FEATURED CATEGORIES BANNER SECTION (MATCHING REFERENCE IMAGE LAYOUT) -->
        <div class="featured-cat-section" id="featured-categories">
            <div class="featured-cat-header">
                <h2>DANH MỤC SẢN PHẨM MỸ PHẨM CAO CẤP</h2>
                <p>100% Mỹ phẩm chính hãng, thuần chay & chăm sóc da chuyên sâu đạt chuẩn y khoa</p>
            </div>
            <div class="featured-cat-pills">
                <a href="/Product/List" class="cat-pill-item active">
                    <i class="fa-solid fa-layer-group me-1"></i> Tất Cả <span class="cat-pill-badge">24+</span>
                </a>
                <a href="/Product/List?search=Son" class="cat-pill-item">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Son Môi High-End
                </a>
                <a href="/Product/List?search=Kem+dưỡng" class="cat-pill-item">
                    <i class="fa-solid fa-jar me-1"></i> Kem Dưỡng Da
                </a>
                <a href="/Product/List?search=Serum" class="cat-pill-item">
                    <i class="fa-solid fa-vial me-1"></i> Serum Phục Hồi B5
                </a>
                <a href="/Product/List?search=Chống+nắng" class="cat-pill-item">
                    <i class="fa-solid fa-sun me-1"></i> Kem Chống Nắng
                </a>
                <a href="/Product/List?search=Rửa+mặt" class="cat-pill-item">
                    <i class="fa-solid fa-pump-soap me-1"></i> Sữa Rửa Mặt
                </a>
                <a href="/Product/List?search=Tẩy+trang" class="cat-pill-item">
                    <i class="fa-solid fa-droplet me-1"></i> Nước Tẩy Trang
                </a>
                <a href="/Product/List?search=Mặt+nạ" class="cat-pill-item">
                    <i class="fa-solid fa-mask-face me-1"></i> Mặt Nạ Dưỡng
                </a>
                <a href="/Product/List?search=Nước+hoa" class="cat-pill-item">
                    <i class="fa-solid fa-spray-can me-1"></i> Nước Hoa Cao Cấp
                </a>
                <a href="/Product/List?search=Trang+điểm" class="cat-pill-item">
                    <i class="fa-solid fa-palette me-1"></i> Trang Điểm
                </a>
                <a href="/Product/List?search=Combo" class="cat-pill-item">
                    <i class="fa-solid fa-box-open me-1"></i> Set Quà / Combo Da
                </a>
            </div>
        </div>

        <!-- CATEGORIES CIRCLE GRID -->
        <div class="category-circles mb-5">
            <a href="/Product/List?search=Son" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=200&auto=format&fit=crop" alt="Son">
                </div>
                <span>Son môi</span>
            </a>
            <a href="/Product/List?search=Kem+dưỡng" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=200&auto=format&fit=crop" alt="Kem dưỡng">
                </div>
                <span>Kem dưỡng</span>
            </a>
            <a href="/Product/List?search=Serum" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=200&auto=format&fit=crop" alt="Serum">
                </div>
                <span>Serum</span>
            </a>
            <a href="/Product/List?search=Chống+nắng" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=200&auto=format&fit=crop" alt="Kem chống nắng">
                </div>
                <span>Chống nắng</span>
            </a>
            <a href="/Product/List?search=Nước+hoa" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?q=80&w=200&auto=format&fit=crop" alt="Nước hoa">
                </div>
                <span>Nước hoa</span>
            </a>
            <a href="/Product/List?search=Rửa+mặt" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=200&auto=format&fit=crop" alt="Sữa rửa mặt">
                </div>
                <span>Sữa rửa mặt</span>
            </a>
            <a href="/Product/List?search=Trang+điểm" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=200&auto=format&fit=crop" alt="Trang điểm">
                </div>
                <span>Trang điểm</span>
            </a>
            <a href="/Product/List?search=Mặt+nạ" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1567894340315-735d7c361db0?q=80&w=200&auto=format&fit=crop" alt="Mặt nạ">
                </div>
                <span>Mặt nạ</span>
            </a>
        </div>



        <!-- POPULAR BRANDS MARQUEE (Right to Left Infinite Slider) -->
        <div class="brands-card mb-5">
            

            <div class="brands-ticker-wrap">
                @{
                    var fallbackLogos = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                    {
                        { "MeiLing", "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=200&auto=format&fit=crop" },
                        { "Cocoon", "https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=200&auto=format&fit=crop" },
                        { "Cỏ Mềm", "https://images.unsplash.com/photo-1540555700478-4be289fbecef?q=80&w=200&auto=format&fit=crop" },
                        { "CeraVe", "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/CeraVe_logo.svg/320px-CeraVe_logo.svg.png" },
                        { "Bioderma", "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b8/Bioderma_logo.svg/320px-Bioderma_logo.svg.png" },
                        { "La Roche-Posay", "https://upload.wikimedia.org/wikipedia/commons/thumb/0/08/La_Roche-Posay_logo.svg/320px-La_Roche-Posay_logo.svg.png" },
                        { "Paula's Choice", "https://images.unsplash.com/photo-1626784215021-2e39ccf971cd?q=80&w=200&auto=format&fit=crop" },
                        { "Klairs", "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=200&auto=format&fit=crop" },
                        { "Skin1004", "https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=200&auto=format&fit=crop" },
                        { "Anessa", "https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=200&auto=format&fit=crop" },
                        { "L'Oréal Paris", "https://upload.wikimedia.org/wikipedia/commons/thumb/9/9d/L%27Or%C3%A9al_logo.svg/320px-L%27Or%C3%A9al_logo.svg.png" },
                        { "Vichy", "https://upload.wikimedia.org/wikipedia/commons/thumb/6/65/Vichy_logo.svg/320px-Vichy_logo.svg.png" }
                    };

                    var displayBrands = Model.Brands != null && Model.Brands.Any()
                        ? Model.Brands.Take(12).Select(b => new { Id = (int?)b.Id, Name = b.Name, Logo = !string.IsNullOrEmpty(b.LogoUrl) ? b.LogoUrl : (fallbackLogos.TryGetValue(b.Name, out var l) ? l : null) }).ToList()
                        : fallbackLogos.Select(kvp => new { Id = (int?)null, Name = kvp.Key, Logo = (string?)kvp.Value }).ToList();
                }

                <div class="brands-ticker-track">
                    @for (int loop = 0; loop < 2; loop++)
                    {
                        @foreach (var item in displayBrands)
                        {
                            var href = item.Id.HasValue ? $"/Product/List?brandId={item.Id}" : $"/Product/List?search={Uri.EscapeDataString(item.Name)}";
                            <a href="@href" class="brand-ticker-item">
                                @if (!string.IsNullOrEmpty(item.Logo))
                                {
                                    <img src="@item.Logo" alt="@item.Name" onerror="this.style.display='none';" />
                                }
                                <span>@item.Name</span>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- FLASH SALE GIỜ VÀNG CONTAINER WIDGET (MATCHING SCREENSHOT 1) -->
        <div class="home-flash-section">
            <div class="home-flash-header">
                <div class="home-flash-title">
                    <span>⚡ FLASH SALE GIỜ VÀNG</span>
                    <div class="home-flash-timer-box ms-2">
                        <div class="home-flash-num" id="hmCdHours">13</div>
                        <span class="fw-bold" style="color: #c70d3a;">:</span>
                        <div class="home-flash-num" id="hmCdMinutes">12</div>
                        <span class="fw-bold" style="color: #c70d3a;">:</span>
                        <div class="home-flash-num" id="hmCdSeconds">41</div>
                    </div>
                </div>
                <a asp-controller="FlashSale" asp-action="Index" class="text-decoration-none fw-bold small" style="color: #c70d3a;">
                    Xem Tất Cả <i class="fa-solid fa-chevron-right ms-1"></i>
                </a>
            </div>

            <div class="row g-3">
                @if (Model.Bestsellers != null && Model.Bestsellers.Any())
                {
                    @foreach (var p in Model.Bestsellers.Take(5))
                    {
                        decimal origP = p.Price;
                        decimal saleP = p.PromoPrice ?? origP * 0.8m;
                        int discPct = origP > 0 ? (int)((origP - saleP) * 100 / origP) : 17;

                        <div class="col-5col">
                            <div class="prod-card h-100 position-relative">
                                <span class="home-flash-badge">⚡-@discPct%</span>
                                <button class="wishlist-btn" onclick="toggleWishlist(this, @p.Id)" title="Yêu thích">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                                <a href="@Url.Action("Details", "Product", new { id = p.Id })" class="text-decoration-none d-block">
                                    <div class="prod-card-img-wrap">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop" : p.ImageUrl)" alt="@p.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop';" />
                                    </div>
                                    <div class="prod-brand">@(p.Brand?.Name ?? (p.Category?.Name ?? "Beauty Glow"))</div>
                                    <h3 class="prod-name">@p.Name</h3>
                                </a>
                                <div class="prod-rating">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <span>(128)</span>
                                </div>
                                <div class="prod-price-row">
                                    <span class="prod-price">@string.Format("{0:N0}đ", saleP)</span>
                                    <span class="prod-old-price">@string.Format("{0:N0}đ", origP)</span>
                                </div>
                                <div class="prod-actions-row mt-auto">
                                    <button class="prod-add-btn" onclick="initAddToCart(this)" data-prod-id="@p.Id" data-prod-name="@p.Name" title="Thêm vào giỏ hàng">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Giỏ hàng
                                    </button>
                                    <button class="prod-buy-btn" onclick="initBuyNow(this, @p.Id)" title="Mua ngay">
                                        Mua ngay <i class="fa-solid fa-bolt ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- MAIN LAYOUT: Split sections -->
        <div class="row g-4 mb-5">
            
            <!-- BEST SELLERS (Full Width 12 Grid) -->
            <div class="col-lg-12">
                
                <div class="section-header">
                    <h2><i class="fa-solid fa-fire-flame-simple"></i> SẢN PHẨM BÁN CHẠY</h2>
                    <a asp-controller="Product" asp-action="List" asp-route-sort="bestseller" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <!-- Products Grid -->
                <div class="row g-3">
                    @if (Model.Bestsellers != null && Model.Bestsellers.Any())
                    {
                        @foreach (var item in Model.Bestsellers)
                        {
                            <div class="col-5col">
                                <div class="prod-card h-100">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, @item.Id)" title="Yêu thích">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="text-decoration-none d-block">
                                        <div class="prod-card-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : item.ImageUrl)" alt="@item.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop';" />
                                        </div>
                                        <div class="prod-brand">@(item.Brand?.Name ?? "Beauty Glow")</div>
                                        <h3 class="prod-name">@item.Name</h3>
                                    </a>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                        <span>(@(item.Reviews?.Count ?? 15))</span>
                                    </div>
                                    <div class="prod-price-row">
                                        @if (item.PromoPrice.HasValue && item.PromoPrice < item.Price)
                                        {
                                            <span class="prod-price">@string.Format("{0:N0}đ", item.PromoPrice.Value)</span>
                                            <span class="prod-old-price">@string.Format("{0:N0}đ", item.Price)</span>
                                        }
                                        else
                                        {
                                            <span class="prod-price">@string.Format("{0:N0}đ", item.Price)</span>
                                        }
                                    </div>
                                    <div class="prod-actions-row mt-auto">
                                         <button class="prod-add-btn" onclick="initAddToCart(this)" data-prod-id="@item.Id" data-prod-name="@item.Name" title="Thêm vào giỏ hàng">
                                             <i class="fa-solid fa-cart-plus me-1"></i> Giỏ hàng
                                         </button>
                                         <button class="prod-buy-btn" onclick="initBuyNow(this, @item.Id)" title="Mua ngay">
                                             Mua ngay <i class="fa-solid fa-bolt ms-1"></i>
                                         </button>
                                     </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @for (int i = 1; i <= 4; i++)
                        {
                            var names = new[] { "Son Tint Lì Romand Juicy Lasting Tint", "Sữa Rửa Mặt CeraVe Foaming Cleanser 236ml", "Tinh Chất Serum Phục Hồi B5 La Roche-Posay", "Kem Chống Nắng Anessa Gold Milk SPF50+" };
                            var brands = new[] { "Romand", "CeraVe", "La Roche-Posay", "Anessa" };
                            var prices = new[] { "195,000đ", "320,000đ", "950,000đ", "680,000đ" };
                            var imgs = new[] {
                                "https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=300&auto=format&fit=crop"
                            };

                            <div class="col-5col">
                                <div class="prod-card h-100">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, 0)">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <div class="prod-card-img-wrap">
                                        <img src="@imgs[i-1]" alt="@names[i-1]" />
                                    </div>
                                    <div class="prod-brand">@brands[i-1]</div>
                                    <h3 class="prod-name">@names[i-1]</h3>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(128)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@prices[i-1]</span>
                                    </div>
                                    <div class="prod-actions-row mt-auto">
                                         <button class="prod-add-btn" onclick="alert('Đã thêm sản phẩm demo vào giỏ!')">
                                             <i class="fa-solid fa-cart-plus me-1"></i> Giỏ hàng
                                         </button>
                                         <button class="prod-buy-btn" onclick="window.location.href='/Cart'">
                                             Mua ngay <i class="fa-solid fa-bolt ms-1"></i>
                                         </button>
                                     </div>
                                </div>
                            </div>
                        }
                    }
                </div>

            </div>

        </div>



        <!-- BOTTOM GRID (NEW PRODUCTS, BLOG, REVIEWS) -->
        <div class="row g-4 mb-5">
            
            <!-- NEW PRODUCTS & BLOG (Full 12 Grid) -->
            <div class="col-lg-12">
                
                <div class="section-header">
                    <h2><i class="fa-solid fa-wand-magic-sparkles"></i> SẢN PHẨM MỚI NHẤT</h2>
                    <a asp-controller="Product" asp-action="List" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <div class="row g-3 mb-5">
                    @if (Model.NewProducts != null && Model.NewProducts.Any())
                    {
                        @foreach (var item in Model.NewProducts)
                        {
                            <div class="col-5col">
                                <div class="prod-card h-100">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, @item.Id)" title="Yêu thích">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="text-decoration-none d-block">
                                        <div class="prod-card-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : item.ImageUrl)" alt="@item.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop';" />
                                        </div>
                                        <div class="prod-brand">@(item.Brand?.Name ?? "Beauty Glow")</div>
                                        <h3 class="prod-name">@item.Name</h3>
                                    </a>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(5)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@string.Format("{0:N0}đ", item.Price)</span>
                                    </div>
                                    <button class="prod-add-btn mt-auto" onclick="initAddToCart(this)" data-prod-id="@item.Id" data-prod-name="@item.Name">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback Static Cards -->
                        @for (int i = 1; i <= 4; i++)
                        {
                            var names = new[] { "Nước Thần Hóa Hồng Hada Labo 170ml", "Kem Dưỡng Bioderma Cicabio Crème 40ml", "Nước Tẩy Trang L'Oréal Paris Sạch Sâu", "Serum Liftactiv Vichy B3 Mờ Thâm" };
                            var brands = new[] { "Hada Labo", "Bioderma", "L'Oréal", "Vichy" };
                            var prices = new[] { "169,000đ", "299,000đ", "179,000đ", "939,000đ" };
                            var imgs = new[] {
                                "https://images.unsplash.com/photo-1626784215021-2e39ccf971cd?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop"
                            };

                            <div class="col-5col">
                                <div class="prod-card h-100">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, 0)">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <div class="prod-card-img-wrap">
                                        <img src="@imgs[i-1]" alt="@names[i-1]" />
                                    </div>
                                    <div class="prod-brand">@brands[i-1]</div>
                                    <h3 class="prod-name">@names[i-1]</h3>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(24)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@prices[i-1]</span>
                                    </div>
                                    <button class="prod-add-btn" onclick="alert('Đã thêm sản phẩm demo vào giỏ!')">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- BEAUTY BLOG -->
                <div class="section-header">
                    <h2><i class="fa-solid fa-book-open-reader"></i> BLOG LÀM ĐẸP</h2>
                    <a asp-controller="Blog" asp-action="Index" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <!-- Beauty Blog Full Grid (Max 6 Posts) -->
                <div class="row g-3">
                    @if (Model.BlogPosts != null && Model.BlogPosts.Any())
                    {
                        @foreach (var post in Model.BlogPosts.Take(6))
                        {
                            <div class="col-md-6 col-lg-4">
                                <a href="/Blog/Details/@(string.IsNullOrEmpty(post.Slug) ? post.Id.ToString() : post.Slug)" class="text-decoration-none d-block h-100">
                                    <div class="blog-card h-100">
                                        <div class="blog-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=400&auto=format&fit=crop" : post.ImageUrl)" alt="@post.Title" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=400&auto=format&fit=crop';" />
                                        </div>
                                        <div class="blog-content">
                                            <span class="blog-date">@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                            <h4 class="blog-title">@post.Title</h4>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        var staticBlogs = new[] { "5 bước chăm sóc da cho làn da khỏe mạnh", "Bí quyết trang điểm lâu trôi cả ngày dài", "Top kem chống nắng được yêu thích nhất 2026" };
                        var blogDates = new[] { "19 Tháng 7, 2026", "17 Tháng 7, 2026", "15 Tháng 7, 2026" };
                        var blogImgs = new[] {
                            "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=400&auto=format&fit=crop",
                            "https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=400&auto=format&fit=crop",
                            "https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=400&auto=format&fit=crop"
                        };
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="col-md-6 col-lg-4">
                                <a asp-controller="Blog" asp-action="Index" class="text-decoration-none d-block h-100">
                                    <div class="blog-card h-100">
                                        <div class="blog-img-wrap">
                                            <img src="@blogImgs[i]" alt="@staticBlogs[i]" />
                                        </div>
                                        <div class="blog-content">
                                            <span class="blog-date">@blogDates[i]</span>
                                            <h4 class="blog-title">@staticBlogs[i]</h4>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Set home page class on body for full-width layout overrides
        document.body.classList.add('home-page-active');

        // HORIZONTAL PRODUCT SLIDER CONTROLLER
        function scrollSlider(trackId, direction) {
            const track = document.getElementById(trackId);
            if (!track) return;
            const scrollAmount = track.clientWidth * 0.75;
            if (direction === 'left') {
                track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            } else {
                track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }

        function initAutoSlider(trackId, intervalMs = 3500) {
            const track = document.getElementById(trackId);
            if (!track) return;
            let timer = setInterval(() => {
                if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 15) {
                    track.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    track.scrollBy({ left: 260, behavior: 'smooth' });
                }
            }, intervalMs);

            track.addEventListener('mouseenter', () => clearInterval(timer));
            track.addEventListener('mouseleave', () => {
                timer = setInterval(() => {
                    if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 15) {
                        track.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        track.scrollBy({ left: 260, behavior: 'smooth' });
                    }
                }, intervalMs);
            });
        }

        // COUNTDOWN TIMER FOR FLASH SALE
        function startCountdown(durationSecs) {
            let timer = durationSecs;
            const interval = setInterval(function () {
                const days = Math.floor(timer / (24 * 3600));
                const hours = Math.floor((timer % (24 * 3600)) / 3600);
                const minutes = Math.floor((timer % 3600) / 60);
                const seconds = timer % 60;

                document.getElementById("cdDays").textContent = days.toString().padStart(2, '0');
                document.getElementById("cdHours").textContent = hours.toString().padStart(2, '0');
                document.getElementById("cdMinutes").textContent = minutes.toString().padStart(2, '0');
                document.getElementById("cdSeconds").textContent = seconds.toString().padStart(2, '0');

                if (--timer < 0) {
                    clearInterval(interval);
                    document.getElementById("flashCountdown").innerHTML = "HẾT HẠN";
                }
            }, 1000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Start a 2-day countdown timer
            startCountdown(2 * 24 * 3600 + 18 * 3600 + 45 * 60 + 12);
        });

        // WISHLIST INTERACTION
        function toggleWishlist(btn, prodId) {
            btn.classList.toggle('active');
            const icon = btn.querySelector('i');
            
            if (btn.classList.contains('active')) {
                icon.style.color = '#c70d3a';
                if (prodId > 0) {
                    fetch('/Wishlist/Add?productId=' + prodId, { method: 'POST' });
                    if (typeof showCartToast === 'function') {
                        showCartToast('Đã thêm sản phẩm vào danh sách yêu thích!');
                    }
                } else {
                    alert('Đã thêm sản phẩm demo vào danh sách yêu thích!');
                }
            } else {
                icon.style.color = '#cbd5e1';
                if (prodId > 0) {
                    fetch('/Wishlist/Remove?productId=' + prodId, { method: 'POST' });
                }
            }
        }

        // ADD TO CART INTERACTION
        function initAddToCart(btn) {
            const prodId = btn.dataset.prodId;
            const prodName = btn.dataset.prodName || 'Sản phẩm';

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-hourglass-half"></i>';

            fetch(`/Cart/AddToCart?productId=${prodId}&quantity=1`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-cart-plus me-1"></i> Giỏ hàng';
                    if (data.success) {
                        const parent = btn.parentElement;
                        if (parent) {
                            btn.classList.add('d-none');
                            let qtyRow = parent.querySelector('.qty-stepper-wrap');
                            if (!qtyRow) {
                                qtyRow = document.createElement('div');
                                qtyRow.className = 'qty-stepper-wrap d-inline-flex align-items-center border rounded bg-light px-2 py-1 me-1';
                                qtyRow.id = `qtyRow-${prodId}`;
                                qtyRow.innerHTML = `
                                    <button type="button" class="btn btn-sm py-0 px-2 fw-bold text-danger border-0" onclick="changeQtyAndSync(${prodId}, -1)">−</button>
                                    <input type="number" class="form-control form-control-sm text-center border-0 bg-transparent fw-bold p-0 text-dark" style="width:30px;" id="qtyInput-${prodId}" value="1" readonly />
                                    <button type="button" class="btn btn-sm py-0 px-2 fw-bold text-danger border-0" onclick="changeQtyAndSync(${prodId}, 1)">+</button>
                                `;
                                parent.insertBefore(qtyRow, btn);
                            } else {
                                qtyRow.classList.remove('d-none');
                                const input = qtyRow.querySelector('input');
                                if (input) input.value = 1;
                            }
                        }

                        if (typeof showCartToast === 'function') {
                            showCartToast(`Đã thêm ${prodName} vào giỏ hàng!`);
                        }
                        if (typeof refreshCartBadge === 'function') {
                            refreshCartBadge();
                        }
                    } else {
                        if (data.requireLogin) {
                            alert(data.message || 'Vui lòng đăng nhập!');
                            window.location.href = '/Account/Login';
                        } else {
                            alert(data.message || 'Lỗi khi thêm sản phẩm vào giỏ.');
                        }
                    }
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-cart-plus me-1"></i> Giỏ hàng';
                    alert('Lỗi kết nối máy chủ.');
                });
        }

        // BUY NOW INTERACTION
        function initBuyNow(btn, prodId) {
            if (!prodId || prodId <= 0) {
                window.location.href = '/Cart';
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-hourglass-half"></i>';

            fetch(`/Cart/AddToCart?productId=${prodId}&quantity=1`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    btn.innerHTML = 'Mua ngay <i class="fa-solid fa-bolt ms-1"></i>';
                    if (data.success) {
                        window.location.href = '/Cart';
                    } else {
                        if (data.requireLogin) {
                            alert(data.message || 'Vui lòng đăng nhập!');
                            window.location.href = '/Account/Login';
                        } else {
                            alert(data.message || 'Lỗi khi đặt mua sản phẩm.');
                        }
                    }
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.innerHTML = 'Mua ngay <i class="fa-solid fa-bolt ms-1"></i>';
                    alert('Lỗi kết nối máy chủ.');
                });
        }
    </script>
}
