@section Scripts {
    <script>
        // Set home page class on body for full-width layout overrides
        document.body.classList.add('home-page-active');

        // COUNTDOWN TIMER FOR FLASH SALE
        function startCountdown(durationSecs) {
            let timer = durationSecs;
            const interval = setInterval(function () {
                const days = Math.floor(timer / (24 * 3600));
                const hours = Math.floor((timer % (24 * 3600)) / 3600);
                const minutes = Math.floor((timer % 3600) / 60);
                const seconds = timer % 60;

                document.getElementById("cdDays").textContent = days.toString().padStart(2, '0');
                document.getElementById("cdHours").textContent = hours.toString().padStart(2, '0');
                document.getElementById("cdMinutes").textContent = minutes.toString().padStart(2, '0');
                document.getElementById("cdSeconds").textContent = seconds.toString().padStart(2, '0');

                if (--timer < 0) {
                    clearInterval(interval);
                    document.getElementById("flashCountdown").innerHTML = "HẾT HẠN";
                }
            }, 1000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Start a 2-day countdown timer
            startCountdown(2 * 24 * 3600 + 18 * 3600 + 45 * 60 + 12);
        });

        // WISHLIST INTERACTION
        function toggleWishlist(btn, prodId) {
            btn.classList.toggle('active');
            const icon = btn.querySelector('i');
            
            if (btn.classList.contains('active')) {
                icon.style.color = '#c70d3a';
                if (prodId > 0) {
                    fetch('/Wishlist/Add?productId=' + prodId, { method: 'POST' });
                    if (typeof showCartToast === 'function') {
                        showCartToast('Đã thêm sản phẩm vào danh sách yêu thích!');
                    }
                } else {
                    alert('Đã thêm sản phẩm demo vào danh sách yêu thích!');
                }
            } else {
                icon.style.color = '#cbd5e1';
                if (prodId > 0) {
                    fetch('/Wishlist/Remove?productId=' + prodId, { method: 'POST' });
                }
            }
        }

        // ADD TO CART INTERACTION
        function initAddToCart(btn) {
            const prodId = btn.dataset.prodId;
            const prodName = btn.dataset.prodName || 'Sản phẩm';

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-hourglass-half"></i>';

            fetch(`/Cart/AddToCart?productId=${prodId}&quantity=1`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ';
                    if (data.success) {
                        if (typeof showCartToast === 'function') {
                            showCartToast(`Đã thêm ${prodName} vào giỏ hàng!`);
                        }
                        if (typeof refreshCartBadge === 'function') {
                            refreshCartBadge();
                        }
                    } else {
                        alert(data.message || 'Lỗi khi thêm sản phẩm vào giỏ.');
                    }
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ';
                    alert('Lỗi kết nối máy chủ.');
                });
        }
    </script>
}
