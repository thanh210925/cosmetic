@model COSMETICC.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Beauty Glow";
}

<!-- Link Google Fonts & CSS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="~/css/home-luxury-red.css" asp-append-version="true" />

<style>
    /* Scope these overrides to the home page only to break out of standard layout margins if needed */
    .home-container {
        padding-top: 0px;
    }
    .pb-3 {
        padding-bottom: 0 !important;
    }
</style>

<div class="home-container">
    
    <!-- TOP PROMO MARQUEE (Full Bleed at the very top of page viewport) -->
    <div class="top-announcement full-bleed">
        <div class="container d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex gap-4 flex-wrap">
                <span><i class="fa-solid fa-truck-fast me-2"></i> FREESHIP cho đơn từ 299.000đ</span>
                <span><i class="fa-solid fa-shield-halved me-2"></i> 100% SẢN PHẨM CHÍNH HÃNG</span>
                <span><i class="fa-solid fa-rotate me-2"></i> ĐỔI TRẢ TRONG 7 NGÀY</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="fa-solid fa-phone me-1"></i> Hotline: <strong>1900 6868</strong></span>
                <div class="social-icons d-none d-md-inline-block">
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- HERO BANNER / SLIDESHOW (Split screen Full Bleed sitting behind transparent header) -->
    <div class="hero-slider">
        <div class="hero-slide-split">
            <div class="hero-left-col">
                <div class="hero-text-wrapper">
                    <span class="new-tag">New Collection 2026</span>
                    <h1>Beauty Begins With<br>Healthy Skin</h1>
                    <p>Rạng rỡ hơn mỗi ngày cùng Beauty Glow. Mỹ phẩm cao cấp thuần chay nuôi dưỡng làn da tươi trẻ rạng ngời.</p>
                    <div class="discount-text">GIẢM ĐẾN <span>50%</span></div>
                    <a asp-controller="Product" asp-action="List" class="hero-btn">MUA NGAY <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="hero-right-col">
                <img src="https://images.unsplash.com/photo-1526947425960-945c6e72858f?q=80&w=1200&auto=format&fit=crop" alt="Hero Cosmetic Model" />
            </div>
        </div>
    </div>

    <!-- MAIN CENTERED CONTENT CONTAINER -->
    <div class="container home-inner-container my-5">
        
        <!-- CATEGORIES CIRCLE GRID -->
        <div class="category-circles mb-5">
            <a href="/Product/List?search=Son" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=200&auto=format&fit=crop" alt="Son">
                </div>
                <span>Son môi</span>
            </a>
            <a href="/Product/List?search=Kem+dưỡng" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=200&auto=format&fit=crop" alt="Kem dưỡng">
                </div>
                <span>Kem dưỡng</span>
            </a>
            <a href="/Product/List?search=Serum" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=200&auto=format&fit=crop" alt="Serum">
                </div>
                <span>Serum</span>
            </a>
            <a href="/Product/List?search=Chống+nắng" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=200&auto=format&fit=crop" alt="Kem chống nắng">
                </div>
                <span>Chống nắng</span>
            </a>
            <a href="/Product/List?search=Nước+hoa" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?q=80&w=200&auto=format&fit=crop" alt="Nước hoa">
                </div>
                <span>Nước hoa</span>
            </a>
            <a href="/Product/List?search=Rửa+mặt" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=200&auto=format&fit=crop" alt="Sữa rửa mặt">
                </div>
                <span>Sữa rửa mặt</span>
            </a>
            <a href="/Product/List?search=Trang+điểm" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=200&auto=format&fit=crop" alt="Trang điểm">
                </div>
                <span>Trang điểm</span>
            </a>
            <a href="/Product/List?search=Mặt+nạ" class="category-circle-item">
                <div class="category-circle-img">
                    <img src="https://images.unsplash.com/photo-1567894340315-735d7c361db0?q=80&w=200&auto=format&fit=crop" alt="Mặt nạ">
                </div>
                <span>Mặt nạ</span>
            </a>
        </div>

        <!-- MAIN LAYOUT: Split sections -->
        <div class="row g-4 mb-5">
            
            <!-- LEFT COLUMN (BEST SELLERS) - 8/12 grid -->
            <div class="col-lg-8">
                
                <div class="section-header">
                    <h2><i class="fa-solid fa-fire-flame-simple"></i> SẢN PHẨM BÁN CHẠY</h2>
                    <a asp-controller="Product" asp-action="List" asp-route-sort="bestseller" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <!-- Products Grid -->
                <div class="row g-3">
                    @if (Model.Bestsellers != null && Model.Bestsellers.Any())
                    {
                        @foreach (var item in Model.Bestsellers)
                        {
                            <div class="col-md-6 col-xl-3 col-6">
                                <div class="prod-card">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, @item.Id)" title="Yêu thích">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="text-decoration-none d-block">
                                        <div class="prod-card-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : item.ImageUrl)" alt="@item.Name" />
                                        </div>
                                        <div class="prod-brand">@(item.Brand?.Name ?? "Beauty Glow")</div>
                                        <h3 class="prod-name">@item.Name</h3>
                                    </a>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                        <span>(@(item.Reviews?.Count ?? 15))</span>
                                    </div>
                                    <div class="prod-price-row">
                                        @if (item.PromoPrice.HasValue && item.PromoPrice < item.Price)
                                        {
                                            <span class="prod-price">@string.Format("{0:N0}đ", item.PromoPrice.Value)</span>
                                            <span class="prod-old-price">@string.Format("{0:N0}đ", item.Price)</span>
                                        }
                                        else
                                        {
                                            <span class="prod-price">@string.Format("{0:N0}đ", item.Price)</span>
                                        }
                                    </div>
                                    <button class="prod-add-btn mt-auto" onclick="initAddToCart(this)" data-prod-id="@item.Id" data-prod-name="@item.Name">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback Static Premium Cards if DB has no data -->
                        @for (int i = 1; i <= 4; i++)
                        {
                            var names = new[] { "Son Tint Lì Romand Juicy Lasting Tint", "Sữa Rửa Mặt CeraVe Foaming Cleanser 236ml", "Tinh Chất Serum Phục Hồi B5 La Roche-Posay", "Kem Chống Nắng Anessa Gold Milk SPF50+" };
                            var brands = new[] { "Romand", "CeraVe", "La Roche-Posay", "Anessa" };
                            var prices = new[] { "195,000đ", "320,000đ", "950,000đ", "680,000đ" };
                            var imgs = new[] {
                                "https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=300&auto=format&fit=crop"
                            };

                            <div class="col-md-6 col-xl-3 col-6">
                                <div class="prod-card">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, 0)">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <div class="prod-card-img-wrap">
                                        <img src="@imgs[i-1]" alt="@names[i-1]" />
                                    </div>
                                    <div class="prod-brand">@brands[i-1]</div>
                                    <h3 class="prod-name">@names[i-1]</h3>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(128)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@prices[i-1]</span>
                                    </div>
                                    <button class="prod-add-btn" onclick="alert('Đã thêm sản phẩm demo vào giỏ!')">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

            </div>

            <!-- RIGHT COLUMN (FLASH SALE & BRANDS) - 4/12 grid -->
            <div class="col-lg-4 d-flex flex-column gap-4">
                
                <!-- FLASH SALE PANEL -->
                <div class="flash-sale-card position-relative">
                    <div class="flash-sale-header">
                        <h3 class="flash-sale-title"><i class="fa-solid fa-bolt me-2"></i> FLASH SALE</h3>
                        <div class="countdown-timer" id="flashCountdown">
                            <div class="countdown-box" id="cdDays">01</div>
                            <div class="countdown-box" id="cdHours">12</div>
                            <div class="countdown-box" id="cdMinutes">45</div>
                            <div class="countdown-box" id="cdSeconds">30</div>
                        </div>
                    </div>

                    @if (Model.FlashSaleProduct != null)
                    {
                        <div class="flash-product">
                            <div class="flash-img-wrap position-relative">
                                <span class="flash-badge">-40%</span>
                                <img src="@(string.IsNullOrEmpty(Model.FlashSaleProduct.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : Model.FlashSaleProduct.ImageUrl)" alt="@Model.FlashSaleProduct.Name">
                            </div>
                            <h4 class="prod-name text-center">@Model.FlashSaleProduct.Name</h4>
                            
                            <div class="prod-price-row text-center mb-3">
                                @if (Model.FlashSaleProduct.PromoPrice.HasValue)
                                {
                                    <span class="prod-price fs-4">@string.Format("{0:N0}đ", Model.FlashSaleProduct.PromoPrice.Value)</span>
                                    <span class="prod-old-price">@string.Format("{0:N0}đ", Model.FlashSaleProduct.Price)</span>
                                }
                                else
                                {
                                    <span class="prod-price fs-4">@string.Format("{0:N0}đ", Model.FlashSaleProduct.Price * 0.6m)</span>
                                    <span class="prod-old-price">@string.Format("{0:N0}đ", Model.FlashSaleProduct.Price)</span>
                                }
                            </div>

                            <div class="flash-stock-bar">
                                <div class="flash-stock-fill" style="width: 25%"></div>
                                <div class="flash-stock-text">Chỉ còn @(Model.FlashSaleProduct.Stock ?? 9) sản phẩm</div>
                            </div>

                            <a href="@Url.Action("Details", "Product", new { id = Model.FlashSaleProduct.Id })" class="hero-btn w-100 text-center py-2 fs-6">MUA NGAY <i class="fa-solid fa-bolt ms-1"></i></a>
                        </div>
                    }
                    else
                    {
                        <div class="flash-product">
                            <div class="flash-img-wrap position-relative">
                                <span class="flash-badge">-40%</span>
                                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop" alt="Serum">
                            </div>
                            <h4 class="prod-name text-center">Tinh Chất Trà Xanh Dưỡng Ẩm Innisfree Green Tea Serum</h4>
                            <div class="prod-price-row text-center mb-3">
                                <span class="prod-price fs-4">349,000đ</span>
                                <span class="prod-old-price">560,000đ</span>
                            </div>
                            <div class="flash-stock-bar">
                                <div class="flash-stock-fill" style="width: 15%"></div>
                                <div class="flash-stock-text">Chỉ còn 3 sản phẩm (Bán chạy)</div>
                            </div>
                            <button class="hero-btn w-100 text-center py-2 fs-6" onclick="alert('Đã thêm sản phẩm flash sale vào giỏ!')">MUA NGAY <i class="fa-solid fa-bolt ms-1"></i></button>
                        </div>
                    }
                </div>

                <!-- POPULAR BRANDS GRID -->
                <div class="brands-card">
                    <div class="section-header mb-3 border-0 pb-0">
                        <h2 class="fs-6"><i class="fa-solid fa-star me-2"></i> THƯƠNG HIỆU NỔI TIẾNG</h2>
                    </div>
                    <div class="brands-grid">
                        @if (Model.Brands != null && Model.Brands.Any())
                        {
                            @foreach (var brand in Model.Brands.Take(12))
                            {
                                <a href="/Product/List?brandId=@brand.Id" class="brand-logo-item text-decoration-none">
                                    <span>@brand.Name</span>
                                </a>
                            }
                        }
                        else
                        {
                            var staticBrands = new[] { "DIOR", "CHANEL", "MAC", "L'ORÉAL", "CERAVE", "ANUA", "SKIN1004", "VICHY", "SOME BY MI", "LA ROCHE", "KLAIRS", "AVENE" };
                            @foreach (var bName in staticBrands)
                            {
                                <a href="/Product/List?search=@bName" class="brand-logo-item text-decoration-none">
                                    <span>@bName</span>
                                </a>
                            }
                        }
                    </div>
                </div>

            </div>

        </div>

        <!-- TWO COLUMN PROMO BANNERS -->
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="promo-banner" style="background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('https://images.unsplash.com/photo-1501004318641-b39e6451bec6?q=80&w=500&auto=format&fit=crop');">
                    <div class="promo-content">
                        <h3>COMBO LÀM ĐẸP</h3>
                        <p>Mua nhiều - Tiết kiệm hơn. Trọn bộ dưỡng da chuyên sâu được đề xuất bởi chuyên gia.</p>
                        <a href="/Product/List?categoryId=1" class="promo-btn">KHÁM PHÁ NGAY <i class="fa-solid fa-angle-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="promo-banner" style="background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=500&auto=format&fit=crop');">
                    <div class="promo-content">
                        <h3>BẢO VỆ LÀN DA DƯỚI NẮNG HÈ</h3>
                        <p>Chọn ngay kem chống nắng phù hợp với mọi làn da khô, dầu mụn.</p>
                        <a href="/Product/List?search=Chống+nắng" class="promo-btn">XEM NGAY <i class="fa-solid fa-angle-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM GRID (NEW PRODUCTS, BLOG, REVIEWS) -->
        <div class="row g-4 mb-5">
            
            <!-- NEW PRODUCTS & BLOG (Left column, wide) - 8/12 grid -->
            <div class="col-lg-8">
                
                <div class="section-header">
                    <h2><i class="fa-solid fa-wand-magic-sparkles"></i> SẢN PHẨM MỚI NHẤT</h2>
                    <a asp-controller="Product" asp-action="List" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <div class="row g-3 mb-5">
                    @if (Model.NewProducts != null && Model.NewProducts.Any())
                    {
                        @foreach (var item in Model.NewProducts)
                        {
                            <div class="col-md-6 col-xl-3 col-6">
                                <div class="prod-card">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, @item.Id)" title="Yêu thích">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="text-decoration-none d-block">
                                        <div class="prod-card-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : item.ImageUrl)" alt="@item.Name" />
                                        </div>
                                        <div class="prod-brand">@(item.Brand?.Name ?? "Beauty Glow")</div>
                                        <h3 class="prod-name">@item.Name</h3>
                                    </a>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(5)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@string.Format("{0:N0}đ", item.Price)</span>
                                    </div>
                                    <button class="prod-add-btn mt-auto" onclick="initAddToCart(this)" data-prod-id="@item.Id" data-prod-name="@item.Name">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback Static Cards -->
                        @for (int i = 1; i <= 4; i++)
                        {
                            var names = new[] { "Nước Thần Hóa Hồng Hada Labo 170ml", "Kem Dưỡng Bioderma Cicabio Crème 40ml", "Nước Tẩy Trang L'Oréal Paris Sạch Sâu", "Serum Liftactiv Vichy B3 Mờ Thâm" };
                            var brands = new[] { "Hada Labo", "Bioderma", "L'Oréal", "Vichy" };
                            var prices = new[] { "169,000đ", "299,000đ", "179,000đ", "939,000đ" };
                            var imgs = new[] {
                                "https://images.unsplash.com/photo-1626784215021-2e39ccf971cd?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1556228578-8c89e6adf883?q=80&w=300&auto=format&fit=crop",
                                "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop"
                            };

                            <div class="col-md-6 col-xl-3 col-6">
                                <div class="prod-card">
                                    <button class="wishlist-btn" onclick="toggleWishlist(this, 0)">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                    <div class="prod-card-img-wrap">
                                        <img src="@imgs[i-1]" alt="@names[i-1]" />
                                    </div>
                                    <div class="prod-brand">@brands[i-1]</div>
                                    <h3 class="prod-name">@names[i-1]</h3>
                                    <div class="prod-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span>(24)</span>
                                    </div>
                                    <div class="prod-price-row">
                                        <span class="prod-price">@prices[i-1]</span>
                                    </div>
                                    <button class="prod-add-btn" onclick="alert('Đã thêm sản phẩm demo vào giỏ!')">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- BEAUTY BLOG -->
                <div class="section-header">
                    <h2><i class="fa-solid fa-book-open-reader"></i> BLOG LÀM ĐẸP</h2>
                    <a asp-controller="Blog" asp-action="Index" class="view-all">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
                </div>

                <div class="row g-3">
                    @if (Model.BlogPosts != null && Model.BlogPosts.Any())
                    {
                        @foreach (var post in Model.BlogPosts)
                        {
                            <div class="col-md-4">
                                <a href="/Blog/Details/@post.Id" class="text-decoration-none d-block h-100">
                                    <div class="blog-card">
                                        <div class="blog-img-wrap">
                                            <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=400&auto=format&fit=crop" : post.ImageUrl)" alt="@post.Title">
                                        </div>
                                        <div class="blog-content">
                                            <span class="blog-date">@post.CreatedAt.ToString("dd/MM/yyyy")</span>
