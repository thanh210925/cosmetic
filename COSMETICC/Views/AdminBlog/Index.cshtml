@model IEnumerable<COSMETICC.Models.BlogPost>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Bài viết & Cộng đồng";
}

<div class="container-fluid px-4">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-journal-richtext text-muted me-2"></i>Quản lý Bài viết & Cộng đồng</h4>
            <small class="text-muted">Kiểm duyệt các bài viết của thành viên, bật/tắt hiển thị, quản lý bài đăng SEO của Admin</small>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold px-3" style="background:#800020; border:none; height: 38px; line-height: 24px;">
            <i class="bi bi-plus-lg me-1"></i> Tạo bài viết của Admin
        </a>
    </div>

    <div class="admin-card m-0">
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th style="width: 25%;">Tiêu đề</th>
                        <th>Người đăng (Tác giả)</th>
                        <th>Chủ đề (Tags)</th>
                        <th>Tương tác</th>
                        <th>Ngày tạo</th>
                        <th>Hiển thị (Duyệt)</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var post in Model)
                        {
                            <tr id="row-@post.Id">
                                <td>
                                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                                    {
                                        <img src="@post.ImageUrl" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light text-center text-muted" style="width: 50px; height: 50px; line-height: 50px; font-size: 11px;">Không ảnh</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 250px;" title="@post.Title">@post.Title</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 250px;">@post.Summary</small>
                                </td>
                                <td>
                                    @if (post.UserId == null)
                                    {
                                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-shield-lock me-1"></i>Admin</span>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">@(post.User?.FullName ?? "User")</div>
                                        <small class="text-muted font-monospace" style="font-size:11px;">#User-@post.UserId</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(post.Tags))
                                    {
                                        foreach (var tag in post.Tags.Split(','))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary me-1">@tag.Trim()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark">
                                        <div><i class="bi bi-heart text-danger me-1"></i>Thích: <strong>@post.LikesCount</strong></div>
                                        <div><i class="bi bi-chat-text text-primary me-1"></i>Cmt: <strong>@post.CommentsCount</strong></div>
                                        <div><i class="bi bi-share text-success me-1"></i>Share: <strong>@post.SharesCount</strong></div>
                                    </div>
                                </td>
                                <td>@post.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <!-- AJAX Publish Switch -->
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" role="switch" id="publishSwitch-@post.Id" @(post.IsPublished ? "checked" : "") onchange="togglePublish(@post.Id)" style="cursor:pointer; width:40px; height:20px;" />
                                        <label class="form-check-label small ms-1" id="publishLabel-@post.Id" for="publishSwitch-@post.Id">
                                            @(post.IsPublished ? "Đang hiện" : "Đang ẩn")
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="@Url.Action("Details", "Blog", new { slug = post.Slug })" target="_blank" class="btn btn-sm btn-outline-info" title="Xem trên web">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa bài" data-bs-toggle="modal" data-bs-target="#deleteModal-@post.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteModal-@post.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa bài</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-dark text-start">
                                                    Bạn có chắc chắn muốn xóa bài viết <strong>@post.Title</strong>? Hành động này sẽ xóa vĩnh viễn cả bài đăng, lượt thích và bình luận!
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Đồng ý xóa</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-journal-x fs-1 d-block mb-3" style="color: #cbd5e1;"></i>
                                Chưa có bài viết nào được đăng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePublish(id) {
            $.ajax({
                url: '@Url.Action("TogglePublish", "AdminBlog")',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        const label = document.getElementById(`publishLabel-${id}`);
                        if (res.isPublished) {
                            label.innerText = "Đang hiện";
                            label.className = "form-check-label small ms-1 text-success fw-bold";
                        } else {
                            label.innerText = "Đang ẩn";
                            label.className = "form-check-label small ms-1 text-danger fw-bold";
                        }
                    }
                },
                error: function () {
                    alert("Có lỗi xảy ra khi cập nhật trạng thái hiển thị.");
                }
            });
        }
    </script>
}
