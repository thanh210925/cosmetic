@model IEnumerable<COSMETICC.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-card m-0">
        <div class="admin-card-title">
            <span><i class="bi bi-tags text-muted me-2"></i> Danh mục sản phẩm</span>
            <a asp-action="Create" class="btn-action btn-action-primary">
                <i class="bi bi-plus-lg me-1"></i> Thêm mới Danh mục
            </a>
        </div>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã danh mục</th>
                        <th>Tên Danh mục</th>
                        <th>Danh mục cha</th>
                        <th>Mô tả</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#CAT-@item.Id</td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td>
                                    @if (item.ParentCategory != null)
                                    {
                                        <span class="badge bg-secondary-subtle text-dark">@item.ParentCategory.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Gốc (Parent)</span>
                                    }
                                </td>
                                <td>@(item.Description ?? "Không có mô tả")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-outline">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-outline">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">Chưa có danh mục nào được tạo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
