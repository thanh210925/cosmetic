@model COSMETICC.Models.Category

@{
    ViewData["Title"] = "Chi tiết Danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    
    <div class="mb-4">
        <a asp-action="Index" class="btn-action btn-action-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="admin-card m-0" style="max-width: 600px;">
        <div class="admin-card-title pb-3 border-bottom">
            <span><i class="bi bi-tag text-muted me-2"></i> Thông tin chi tiết danh mục</span>
        </div>

        <div class="py-3">
            <table class="admin-table">
                <tbody>
                    <tr>
                        <th style="width: 150px;">Mã danh mục</th>
                        <td class="fw-bold">#CAT-@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Tên Danh mục</th>
                        <td class="fw-bold fs-5 text-dark">@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Mô tả</th>
                        <td>@(Model.Description ?? "Không có mô tả")</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-action btn-action-primary px-4">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-action btn-action-danger px-4">
                    <i class="bi bi-trash me-1"></i> Xóa danh mục
                </a>
            </div>
        </div>
    </div>
</div>
