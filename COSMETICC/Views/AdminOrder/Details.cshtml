@model COSMETICC.Models.Order

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Id}";
    
    var shipping = Model.Shippings?.FirstOrDefault();
    var payment = Model.Payments?.FirstOrDefault();
}

@section Styles {
    <style>
        @@media print {
            /* Hide sidebar, content header, buttons, alerts, status boxes, etc. */
            .sidebar, .content-header, .btn-action, .alert, .status-modify-box, .no-print, .btn-close {
                display: none !important;
            }
            .content {
                margin-left: 0 !important;
                padding: 0 !important;
            }
            .py-4 {
                padding: 0 !important;
            }
            .admin-card {
                border: none !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .print-invoice-title {
                display: block !important;
                text-align: center;
                margin-bottom: 25px;
            }
            /* Make layout full width for print */
            .col-lg-8, .col-lg-4 {
                width: 100% !important;
                flex: 0 0 100% !important;
                max-width: 100% !important;
            }
            .row {
                display: block !important;
            }
        }
        .print-invoice-title {
            display: none;
        }
    </style>
}

<div class="container-fluid px-4">

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Actions Bar -->
    <div class="mb-4 d-flex justify-content-between align-items-center no-print">
        <a asp-action="Index" class="btn-action btn-action-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <button onclick="window.print()" class="btn-action btn-action-primary px-4 py-2">
            <i class="bi bi-printer me-1"></i> In hóa đơn
        </button>
    </div>

    <!-- Print Title Header -->
    <div class="print-invoice-title">
        <h2 style="font-family: serif; letter-spacing: 2px;">MEILING COSMETICS</h2>
        <p>HÓA ĐƠN BÁN HÀNG PHÂN PHỐI</p>
        <p>Mã đơn hàng: <strong>#@Model.Id</strong> | Ngày đặt: @(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm"))</p>
        <hr style="border-top: 2px dashed #000;" />
    </div>

    <div class="row">
        
        <!-- Left Side: Order Items -->
        <div class="col-lg-8 mb-4">
            <div class="admin-card m-0">
                <div class="admin-card-title pb-3 border-bottom">
                    <span><i class="bi bi-bag-check text-muted me-2"></i> Chi tiết sản phẩm trong đơn</span>
                    <span class="fs-6 text-muted no-print">@Model.OrderDetails.Count sản phẩm</span>
                </div>

                <div class="admin-table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                            {
                                                <img src="@item.Product.ImageUrl" class="rounded no-print" style="width: 48px; height: 48px; object-fit: cover;" alt="" />
                                            }
                                            <div>
                                                <div class="fw-bold text-dark">@(item.Product?.Name ?? "N/A")</div>
                                                <small class="text-muted">Mã: @(item.Product?.Id ?? 0)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@String.Format("{0:N0} đ", item.Price)</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold text-dark">@String.Format("{0:N0} đ", item.Price * item.Quantity)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Price summary breakdown -->
                <div class="d-flex justify-content-end mt-4">
                    <div style="width: 280px;">
                        <div class="d-flex justify-content-between py-2 text-muted">
                            <span>Tạm tính:</span>
                            <span class="text-dark">@String.Format("{0:N0} đ", Model.TotalAmount)</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 text-muted">
                            <span>Phí giao hàng:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between py-2 fw-bold text-dark fs-5">
                            <span>Tổng cộng:</span>
                            <span>@String.Format("{0:N0} đ", Model.TotalAmount)</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Side: Shipping & Action Panels -->
        <div class="col-lg-4">
            
            <!-- Modify Status Panel (no-print) -->
            <div class="admin-card m-0 mb-4 status-modify-box no-print">
                <div class="admin-card-title pb-2 border-bottom">
                    <span>⚙️ Trạng thái đơn hàng</span>
                </div>
                
                <div class="py-3">
                    @{
                        var badgeClass = "status-pending";
                        if (Model.Status == "Đang giao" || Model.Status == "Đang đóng gói" || Model.Status == "Đã xác nhận") badgeClass = "status-shipping";
                        else if (Model.Status == "Hoàn thành" || Model.Status == "Đã giao" || Model.Status == "Đã hoàn") badgeClass = "status-completed";
                        else if (Model.Status == "Hủy" || Model.Status == "Đã hủy" || Model.Status == "Giao thất bại" || Model.Status == "Hoàn hàng") badgeClass = "status-cancelled";
                    }
                    <div class="mb-3">
                        <span class="text-muted d-block mb-1">Trạng thái hiện tại:</span>
                        <span class="status-badge @badgeClass" style="font-size: 0.95rem; padding: 6px 14px;">
                            @(Model.Status ?? "Chờ xác nhận")
                        </span>
                    </div>

                    <!-- Direct buttons for common actions based on current status -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        @if (Model.Status == "Chờ xác nhận" || string.IsNullOrEmpty(Model.Status))
                        {
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Đã xác nhận" />
                                <button type="submit" class="btn-action btn-action-primary w-100 py-2">✔️ Xác nhận đơn</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="w-100" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Hủy" />
                                <button type="submit" class="btn-action btn-action-danger w-100 py-2">❌ Hủy đơn</button>
                            </form>
                        }
                        else if (Model.Status == "Đã xác nhận")
                        {
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Đang đóng gói" />
                                <button type="submit" class="btn-action btn-action-primary w-100 py-2">📦 Đã đóng gói</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="w-100" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Hủy" />
                                <button type="submit" class="btn-action btn-action-danger w-100 py-2">❌ Hủy đơn</button>
                            </form>
                        }
                        else if (Model.Status == "Đang đóng gói")
                        {
                            <div class="border p-2 rounded bg-light mb-2">
                                <span class="fw-bold d-block mb-2 text-dark" style="font-size:12.5px;">Bàn giao đơn vị vận chuyển:</span>
                                <div class="d-flex gap-2">
                                    <form asp-action="HandoverToCarrier" method="post" class="w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="carrier" value="GHN" />
                                        <button type="submit" class="btn btn-warning w-100 text-dark fw-bold btn-sm py-2">🚚 Bàn giao GHN</button>
                                    </form>
                                    <form asp-action="HandoverToCarrier" method="post" class="w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="carrier" value="GHTK" />
                                        <button type="submit" class="btn btn-success w-100 text-white fw-bold btn-sm py-2">🚚 Bàn giao GHTK</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else if (Model.Status == "Đang giao")
                        {
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Đã giao" />
                                <button type="submit" class="btn-action btn-action-primary w-100 py-2">🎉 Giao thành công</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Giao thất bại" />
                                <button type="submit" class="btn-action btn-action-danger w-100 py-2">⚠️ Giao thất bại</button>
                            </form>
                        }
                        else if (Model.Status == "Giao thất bại")
                        {
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Đang giao" />
                                <button type="submit" class="btn btn-warning w-100 text-dark fw-bold py-2">🔄 Giao lại</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Hoàn hàng" />
                                <button type="submit" class="btn-action btn-action-danger w-100 py-2">🔙 Hoàn hàng</button>
                            </form>
                        }
                        else if (Model.Status == "Hoàn hàng")
                        {
                            <form asp-action="UpdateStatus" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="Đã hoàn" />
                                <button type="submit" class="btn-action btn-action-primary w-100 py-2">📥 Đã nhận lại hàng hoàn</button>
                            </form>
                        }
                    </div>

                    <!-- Action form to modify state -->
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="form-group mb-3">
                            <label for="statusSelect">Cập nhật trạng thái khác (Ghi đè):</label>
                            <select name="status" id="statusSelect" class="form-control-admin">
                                <!option value="Chờ xác nhận" @(Model.Status == "Chờ xác nhận" ? "selected" : "")>Chờ xác nhận</!option>
                                <!option value="Đã xác nhận" @(Model.Status == "Đã xác nhận" ? "selected" : "")>Đã xác nhận</!option>
                                <!option value="Đang đóng gói" @(Model.Status == "Đang đóng gói" ? "selected" : "")>Đang đóng gói</!option>
                                <!option value="Đang giao" @(Model.Status == "Đang giao" ? "selected" : "")>Đang giao</!option>
                                <!option value="Đã giao" @(Model.Status == "Đã giao" ? "selected" : "")>Đã giao</!option>
                                <!option value="Hoàn thành" @(Model.Status == "Hoàn thành" ? "selected" : "")>Hoàn thành</!option>
                                <!option value="Giao thất bại" @(Model.Status == "Giao thất bại" ? "selected" : "")>Giao thất bại</!option>
                                <!option value="Hoàn hàng" @(Model.Status == "Hoàn hàng" ? "selected" : "")>Hoàn hàng</!option>
                                <!option value="Đã hoàn" @(Model.Status == "Đã hoàn" ? "selected" : "")>Đã hoàn</!option>
                                <!option value="Hủy" @(Model.Status == "Hủy" ? "selected" : "")>Hủy</!option>
                            </select>
                        </div>
                        <button type="submit" class="btn-action btn-action-outline w-100 py-2">
                            Cập nhật trạng thái
                        </button>
                    </form>
                </div>
            </div>

            <!-- Customer & Shipping Information -->
            <div class="admin-card m-0 mb-4">
                <div class="admin-card-title pb-2 border-bottom">
                    <span>👤 Người nhận & Vận chuyển</span>
                </div>
                <div class="py-2">
                    <div class="mb-2">
                        <span class="text-muted d-block small">Tên tài khoản khách:</span>
                        <strong class="text-dark">@(Model.User?.FullName ?? "N/A")</strong> 
                        <span class="text-muted no-print">(@@@(Model.User?.Username ?? "N/A"))</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block small">Email:</span>
                        <span class="text-dark">@(Model.User?.Email ?? "N/A")</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block small">Số điện thoại giao hàng:</span>
                        <strong class="text-dark">@(shipping?.Phone ?? Model.User?.Phone ?? "N/A")</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block small">Địa chỉ nhận hàng:</span>
                        <strong class="text-dark">@(shipping?.Address ?? Model.User?.Address ?? "N/A")</strong>
                    </div>
                    @if (shipping != null && !string.IsNullOrEmpty(shipping.Carrier))
                    {
                        <div class="mb-2 border-top pt-2 mt-2">
                            <span class="text-muted d-block small">Đơn vị vận chuyển:</span>
                            <span class="badge bg-info text-dark fw-bold">@shipping.Carrier</span>
                        </div>
                    }
                    @if (shipping != null && !string.IsNullOrEmpty(shipping.TrackingCode))
                    {
                        <div class="mb-2">
                            <span class="text-muted d-block small">Mã vận đơn:</span>
                            <strong class="text-danger font-monospace">@shipping.TrackingCode</strong>
                        </div>
                    }
                    @if (shipping != null && shipping.EstimatedDeliveryDate.HasValue)
                    {
                        <div class="mb-2">
                            <span class="text-muted d-block small">Dự kiến giao:</span>
                            <strong class="text-success"><i class="bi bi-calendar-event me-1"></i> @shipping.EstimatedDeliveryDate.Value.ToString("dd/MM/yyyy")</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Information -->
            <div class="admin-card m-0">
                <div class="admin-card-title pb-2 border-bottom">
                    <span>💳 Theo dõi thanh toán</span>
                </div>
                <div class="py-2">
                    <div class="mb-2">
                        <span class="text-muted d-block small">Phương thức thanh toán:</span>
                        <strong class="text-dark">@(payment?.PaymentMethod ?? "COD (Thanh toán khi nhận hàng)")</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block small">Trạng thái thanh toán:</span>
                        @if (payment?.PaymentStatus == "Đã thanh toán" || Model.Status == "Hoàn thành")
                        {
                            <span class="badge bg-success">Đã thanh toán</span>
                        }
                        else if (payment?.PaymentStatus == "Đã hủy" || Model.Status == "Hủy")
                        {
                            <span class="badge bg-danger">Đã hủy</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                        }
                    </div>
                    @if (payment?.PaymentDate != null)
                    {
                        <div class="mb-2">
                            <span class="text-muted d-block small">Ngày giao dịch thanh toán:</span>
                            <span class="text-dark">@payment.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>
