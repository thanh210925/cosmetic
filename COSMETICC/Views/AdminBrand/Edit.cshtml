@model COSMETICC.Models.Brand

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa Thương hiệu";
}

<div class="container-fluid px-4" style="max-width: 600px;">
    
    <div class="mb-4">
        <a asp-action="Index" class="btn-action btn-action-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="admin-card m-0">
        <div class="admin-card-title pb-3 border-bottom">
            <span><i class="bi bi-pencil-square text-muted me-2"></i> Chỉnh sửa thông tin thương hiệu</span>
        </div>

        <form asp-action="Edit" method="post" class="py-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name">Tên Thương hiệu</label>
                <input asp-for="Name" class="form-control-admin" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LogoUrl">Đường dẫn Logo (URL)</label>
                <input asp-for="LogoUrl" class="form-control-admin" />
                <span asp-validation-for="LogoUrl" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Country">Quốc gia xuất xứ</label>
                <input asp-for="Country" class="form-control-admin" />
                <span asp-validation-for="Country" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Website">Trang web (Website URL)</label>
                <input asp-for="Website" class="form-control-admin" placeholder="VD: https://brand.com" />
                <span asp-validation-for="Website" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="BannerUrl">Đường dẫn Banner (URL)</label>
                <input asp-for="BannerUrl" class="form-control-admin" placeholder="VD: https://example.com/banner.jpg" />
                <span asp-validation-for="BannerUrl" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-action btn-action-primary px-4 py-2">
                    Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn-action btn-action-outline px-4 py-2 text-center">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
