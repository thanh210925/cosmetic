@model IEnumerable<COSMETICC.Models.Appointment>
@{
    ViewData["Title"] = "Lịch Hẹn Của Tôi — MeiLing Clinic";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ai-hero" style="background: linear-gradient(135deg, #fff5f7 0%, #fcf0f5 40%, #f3e8ff 100%); padding: 50px 0 35px;">
    <div class="container text-center">
        <span class="ai-badge mb-2">📋 MY BOOKINGS</span>
        <h1 class="fw-bold" style="color: #800020; font-size: 2.2rem;">Lịch Hẹn Soi Da & Khám Bác Sĩ Của Tôi</h1>
        <p class="text-muted small">Theo dõi danh sách các lịch hẹn soi da & tư vấn đã đăng ký tại MeiLing Cosmetics.</p>
    </div>
</div>

<div class="py-5" style="background: linear-gradient(180deg, #f8fafc 0%, #fff5f7 100%); min-height: 75vh;">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @Html.Raw(TempData["SuccessMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event me-2 text-danger"></i> Danh Sách Lịch Hẹn (@Model.Count())</h5>
            <a href="@Url.Action("BookAppointment", "AI")" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" style="background-color: #800020; border: none;">
                <i class="bi bi-plus-circle me-1"></i> Đặt Lịch Hẹn Mới
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="bg-white rounded-4 shadow-sm p-5 text-center border">
                <div class="fs-1 text-muted mb-3">📅</div>
                <h5 class="fw-bold text-dark">Bạn Chưa Có Lịch Hẹn Nào</h5>
                <p class="text-muted small mb-4">Hãy đặt lịch soi da 3D VISIA hoặc tư vấn cùng Bác sĩ CKI Da liễu ngay hôm nay.</p>
                <a href="@Url.Action("BookAppointment", "AI")" class="btn btn-danger rounded-pill px-4 fw-bold" style="background-color: #800020; border: none;">
                    Đặt Lịch Hẹn Ngay
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    string statusBadgeClass = item.Status switch
                    {
                        "Đã xác nhận" => "bg-primary text-white",
                        "Đã khám" => "bg-success text-white",
                        "Đã hủy" => "bg-secondary text-white",
                        _ => "bg-warning text-dark"
                    };

                    <div class="col-md-6 col-lg-4">
                        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 position-relative d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge @statusBadgeClass px-3 py-1.5 rounded-pill fw-bold">@item.Status</span>
                                    <small class="text-muted">#APT-@item.Id.ToString("D5")</small>
                                </div>
                                
                                <h6 class="fw-bold text-dark mb-1">@item.ServiceType</h6>
                                <p class="text-danger small fw-bold mb-3">
                                    <i class="bi bi-clock-fill me-1"></i> @item.AppointmentDate.ToString("dd/MM/yyyy") | @item.TimeSlot
                                </p>

                                <div class="bg-light p-3 rounded-3 mb-3 small">
                                    <div class="text-secondary mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.BranchLocation</div>
                                    <div class="text-secondary mb-1"><i class="bi bi-person-badge-fill text-primary me-1"></i> @(string.IsNullOrEmpty(item.DoctorName) ? "Bác sĩ CKI Da liễu" : item.DoctorName)</div>
                                    <div class="text-secondary"><i class="bi bi-telephone-fill me-1"></i> SĐT nhận tin: @item.PhoneNumber</div>
                                </div>

                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <p class="text-muted extra-small mb-0 font-italic">
                                        <i class="bi bi-pencil-square me-1"></i> Ghi chú: "@item.Notes"
                                    </p>
                                }
                            </div>

                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center text-muted extra-small">
                                <span>Ngày đặt: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                @if (item.Status == "Chờ xác nhận")
                                {
                                    <form asp-action="CancelAppointment" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 small">Hủy Lịch</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
