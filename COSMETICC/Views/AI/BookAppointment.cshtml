@model COSMETICC.Models.Appointment
@{
    ViewData["Title"] = "Đặt Lịch Soi Da & Tư Vấn Bác Sĩ Da Liễu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ai-hero" style="background: linear-gradient(135deg, #fff5f7 0%, #fcf0f5 40%, #f3e8ff 100%); padding: 60px 0 45px;">
    <div class="container text-center">
        <span class="ai-badge mb-3">📅 CLINIC APPOINTMENT</span>
        <h1 class="fw-bold" style="color: #800020; font-size: 2.5rem;">Đặt Lịch Soi Da & Tư Vấn Bác Sĩ Da Liễu</h1>
        <p class="text-muted fs-5" style="max-width: 750px; margin: 0 auto;">
            Trải nghiệm công nghệ Soi da 3D VISIA chuẩn y khoa và nhận phác đồ chăm sóc da cá nhân hóa 1:1 cùng Đội ngũ Bác sĩ CKI Da liễu MeiLing.
        </p>
    </div>
</div>

<div class="py-5" style="background: linear-gradient(180deg, #f8fafc 0%, #fff5f7 100%); min-height: 80vh;">
    <div class="container">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-auto mb-4" style="max-width: 850px;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- DOCTORS HIGHLIGHT BAR -->
        <div class="row g-4 mb-5 justify-content-center">
            <div class="col-md-4">
                <div class="bg-white p-3 rounded-4 shadow-sm border text-center h-100 transition-hover">
                    <div class="rounded-circle overflow-hidden mx-auto mb-3" style="width: 80px; height: 80px; background: #fff0f3;">
                        <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?q=80&w=200&auto=format&fit=crop" class="w-100 h-100 object-fit-cover" alt="Doctor 1" />
                    </div>
                    <h6 class="fw-bold text-dark mb-1">BS. CKI Nguyễn Thanh Hà</h6>
                    <span class="badge bg-danger-subtle text-danger rounded-pill mb-2">Chuyên gia Da liễu 12 năm</span>
                    <p class="text-muted small mb-0">Chuyên trị mụn y khoa, phục hồi hàng rào da & trẻ hóa 3D.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-3 rounded-4 shadow-sm border text-center h-100 transition-hover">
                    <div class="rounded-circle overflow-hidden mx-auto mb-3" style="width: 80px; height: 80px; background: #f0f9ff;">
                        <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?q=80&w=200&auto=format&fit=crop" class="w-100 h-100 object-fit-cover" alt="Doctor 2" />
                    </div>
                    <h6 class="fw-bold text-dark mb-1">BS. CKI Trần Minh Tuấn</h6>
                    <span class="badge bg-info-subtle text-info rounded-pill mb-2">Chuyên gia Sắc tố & Nám</span>
                    <p class="text-muted small mb-0">Điều trị thâm nám, sạm da, tàn nhang & chống lão hóa y khoa.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-3 rounded-4 shadow-sm border text-center h-100 transition-hover">
                    <div class="rounded-circle overflow-hidden mx-auto mb-3" style="width: 80px; height: 80px; background: #fef3c7;">
                        <img src="https://images.unsplash.com/photo-1594824813571-2153349aed06?q=80&w=200&auto=format&fit=crop" class="w-100 h-100 object-fit-cover" alt="Doctor 3" />
                    </div>
                    <h6 class="fw-bold text-dark mb-1">ThS. Chuyên gia Lê Hoài Phương</h6>
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill mb-2">Cố vấn Skincare MeiLing</span>
                    <p class="text-muted small mb-0">Thiết kế routine cá nhân hóa, đọc thành phần mỹ phẩm chuyên sâu.</p>
                </div>
            </div>
        </div>

        <!-- MAIN BOOKING FORM CARD -->
        <div class="bg-white rounded-4 shadow-lg p-4 p-md-5 mx-auto border" style="max-width: 900px; border-color: rgba(244, 114, 182, 0.2) !important;">
            <form asp-action="BookAppointment" method="post" id="bookingForm">
                
                <!-- STEP 1: SERVICE -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger rounded-circle p-2" style="background: #800020 !important;">1</span>
                        <h5 class="fw-bold text-dark mb-0">Chọn Gói Dịch Vụ Soi Da / Tư Vấn</h5>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="service-option-card d-block p-3 rounded-3 border cursor-pointer h-100 transition-all">
                                <input type="radio" name="ServiceType" value="Soi Da 3D VISIA & Phân Tích Chuyên Sâu" checked class="d-none" />
                                <div class="d-flex align-items-start gap-3">
                                    <div class="fs-2 text-danger">🔬</div>
                                    <div>
                                        <div class="fw-bold text-dark">Soi Da 3D VISIA & Phân Tích Chuyên Sâu</div>
                                        <div class="text-success small fw-bold mt-1">MIỄN PHÍ 100%</div>
                                        <div class="text-muted extra-small mt-1">Phân tích sắc tố, mụn ẩn, độ ẩm & tuổi da trong 15 phút.</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="service-option-card d-block p-3 rounded-3 border cursor-pointer h-100 transition-all">
                                <input type="radio" name="ServiceType" value="Tư Vấn 1:1 Với Bác Sĩ CKI Da Liễu" class="d-none" />
                                <div class="d-flex align-items-start gap-3">
                                    <div class="fs-2 text-primary">👩‍⚕️</div>
                                    <div>
                                        <div class="fw-bold text-dark">Tư Vấn 1:1 Với Bác Sĩ CKI Da Liễu</div>
                                        <div class="text-danger small fw-bold mt-1">200.000đ <span class="badge bg-danger-subtle text-danger ms-1">Miễn phí khi mua sản phẩm</span></div>
                                        <div class="text-muted extra-small mt-1">Bác sĩ khám trực tiếp, tư vấn bệnh lý da & kê phác đồ chuẩn y khoa.</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="service-option-card d-block p-3 rounded-3 border cursor-pointer h-100 transition-all">
                                <input type="radio" name="ServiceType" value="Phác Đồ Điều Trị Mụn & Nám Chuẩn Y Khoa" class="d-none" />
                                <div class="d-flex align-items-start gap-3">
                                    <div class="fs-2 text-warning">🎯</div>
                                    <div>
                                        <div class="fw-bold text-dark">Phác Đồ Điều Trị Mụn & Nám Chuẩn Y Khoa</div>
                                        <div class="text-success small fw-bold mt-1">MIỄN PHÍ KHÁM BAN ĐẦU</div>
                                        <div class="text-muted extra-small mt-1">Xây dựng liệu trình dứt điểm mụn viêm, mụn ẩn & thâm nám sạm.</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="service-option-card d-block p-3 rounded-3 border cursor-pointer h-100 transition-all">
                                <input type="radio" name="ServiceType" value="Tư Vấn Skincare Routine Online" class="d-none" />
                                <div class="d-flex align-items-start gap-3">
                                    <div class="fs-2 text-info">💻</div>
                                    <div>
                                        <div class="fw-bold text-dark">Tư Vấn Skincare Routine Online (Video Call)</div>
                                        <div class="text-success small fw-bold mt-1">MIỄN PHÍ</div>
                                        <div class="text-muted extra-small mt-1">Tư vấn qua video call từ xa cho khách hàng ở xa clinic.</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: LOCATION & DOCTOR -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger rounded-circle p-2" style="background: #800020 !important;">2</span>
                        <h5 class="fw-bold text-dark mb-0">Chọn Chi Nhánh & Bác Sĩ / Chuyên Gia</h5>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">CHI NHÁNH CLINIC</label>
                            <select name="BranchLocation" class="form-select py-2.5 rounded-3" required>
                                <option value="Chi nhánh Quận 1 — 123 Nguyễn Trãi, P.2, Q.1, TP.HCM">Chi nhánh Quận 1 — 123 Nguyễn Trãi, Q.1</option>
                                <option value="Chi nhánh Quận 3 — 456 Lê Văn Sỹ, P.14, Q.3, TP.HCM">Chi nhánh Quận 3 — 456 Lê Văn Sỹ, Q.3</option>
                                <option value="Chi nhánh Tân Bình — 789 Cộng Hòa, P.13, Q.Tân Bình, TP.HCM">Chi nhánh Tân Bình — 789 Cộng Hòa, Q.Tân Bình</option>
                                <option value="Tư vấn Online qua Video Call (Khách xa)">Tư vấn Online qua Video Call (Từ xa)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">CHỌN BÁC SĨ / CHUYÊN GIA (KHÔNG BẮT BUỘC)</label>
                            <select name="DoctorName" class="form-select py-2.5 rounded-3">
                                <option value="Bác sĩ xếp ngẫu nhiên (Nhanh nhất)">Bác sĩ xếp ngẫu nhiên (Nhanh nhất)</option>
                                <option value="BS. CKI Nguyễn Thanh Hà (Trị mụn & Trẻ hóa)">BS. CKI Nguyễn Thanh Hà (Trị mụn & Trẻ hóa)</option>
                                <option value="BS. CKI Trần Minh Tuấn (Nám & Sắc tố)">BS. CKI Trần Minh Tuấn (Nám & Sắc tố)</option>
                                <option value="ThS. Lê Hoài Phương (Skincare Routine Advisor)">ThS. Lê Hoài Phương (Skincare Routine Advisor)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- STEP 3: DATE & TIME SLOT -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger rounded-circle p-2" style="background: #800020 !important;">3</span>
                        <h5 class="fw-bold text-dark mb-0">Chọn Ngày Hẹn & Khung Giờ</h5>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">NGÀY HẸN</label>
                            <input type="date" name="AppointmentDate" id="appointmentDateInput" 
                                   value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                                   class="form-control py-2.5 rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">KHUNG GIỜ LÀM VIỆC</label>
                            <div class="d-flex gap-2 flex-wrap" id="timeSlotContainer">
                                @foreach (var slot in new[] { "09:00 - 10:00", "10:30 - 11:30", "14:00 - 15:00", "16:00 - 17:00", "18:30 - 19:30" })
                                {
                                    <label class="slot-pill px-3 py-2 border rounded-pill cursor-pointer small font-weight-bold">
                                        <input type="radio" name="TimeSlot" value="@slot" class="d-none" @(slot == "09:00 - 10:00" ? "checked" : "") />
                                        <span>@slot</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4: CUSTOMER INFO -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger rounded-circle p-2" style="background: #800020 !important;">4</span>
                        <h5 class="fw-bold text-dark mb-0">Thông Tin Liên Hệ</h5>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">HỌ VÀ TÊN KHÁCH HÀNG *</label>
                            <input type="text" name="FullName" value="@(ViewBag.UserFullName ?? "")" placeholder="Ví dụ: Nguyễn Văn A" class="form-control py-2.5 rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">SỐ ĐIỆN THOẠI (ĐỂ XÁC NHẬN SMS/ZALO) *</label>
                            <input type="tel" name="PhoneNumber" value="@(ViewBag.UserPhone ?? "")" placeholder="Ví dụ: 0901234567" class="form-control py-2.5 rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">EMAIL</label>
                            <input type="email" name="Email" value="@(ViewBag.UserEmail ?? "")" placeholder="name@example.com" class="form-control py-2.5 rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small">GHI CHÚ TÌNH TRẠNG DA HIỆN TẠI (TÙY CHỌN)</label>
                            <input type="text" name="Notes" placeholder="Ví dụ: Da mụn viêm vùng cằm, nhiều thâm nám..." class="form-control py-2.5 rounded-3" />
                        </div>
                    </div>
                </div>

                <div class="pt-3">
                    <button type="submit" class="btn btn-danger w-100 py-3 rounded-pill fw-bold fs-5 shadow" style="background-color: #800020; border: none;">
                        <i class="bi bi-calendar-check-fill me-2"></i> XÁC NHẬN ĐẶT LỊCH HẸN SOI DA
                    </button>
                    <p class="text-center text-muted extra-small mt-3">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Thông tin của bạn được bảo mật tuyệt đối. MeiLing sẽ gửi tin nhắn SMS / Zalo xác nhận lịch trong vòng 15 phút.
                    </p>
                </div>
            </form>
        </div>

    </div>
</div>

<style>
    .service-option-card {
        background: #ffffff;
        transition: all 0.25s ease;
    }
    .service-option-card:hover {
        border-color: #800020 !important;
        background: #fff0f3;
        transform: translateY(-2px);
    }
    .service-option-card has(:checked),
    .service-option-card:has(input:checked) {
        border-color: #800020 !important;
        background: #fff0f3 !important;
        box-shadow: 0 4px 14px rgba(128, 0, 32, 0.1);
    }
    .slot-pill {
        background: #f8fafc;
        color: #475569;
        transition: all 0.2s ease;
    }
    .slot-pill:hover {
        border-color: #800020 !important;
        color: #800020;
    }
    .slot-pill:has(input:checked) {
        background: #800020 !important;
        border-color: #800020 !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(128, 0, 32, 0.2);
    }
    .transition-hover:hover {
        transform: translateY(-4px);
    }
    .extra-small {
        font-size: 12px;
    }
</style>

<script>
    document.querySelectorAll('.service-option-card input').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.service-option-card').forEach(c => c.style.borderColor = '#e2e8f0');
            if (this.checked) {
                this.closest('.service-option-card').style.borderColor = '#800020';
            }
        });
    });
    document.querySelectorAll('.slot-pill input').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.slot-pill').forEach(p => {
                p.style.backgroundColor = '#f8fafc';
                p.style.color = '#475569';
            });
            if (this.checked) {
                const parent = this.closest('.slot-pill');
                parent.style.backgroundColor = '#800020';
                parent.style.color = '#ffffff';
            }
        });
    });
</script>
