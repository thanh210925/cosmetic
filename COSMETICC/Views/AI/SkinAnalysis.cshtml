@{
    ViewData["Title"] = "AI Phân Tích Da Qua Ảnh Chụp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold mb-2" style="font-size: 13px;">
            <i class="bi bi-magic me-1"></i> AI BEAUTY TECH 4.0
        </span>
        <h2 class="fw-bold" style="color: #800020;">Phân Tích Sức Khỏe Làn Da Bằng AI</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">
            Tải lên bức ảnh chân thực khuôn mặt của bạn. Công nghệ AI tiên tiến sẽ tự động nhận diện và phân tích 4 chỉ số sức khỏe da quan trọng!
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-auto mb-4" style="max-width: 700px;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-lg p-4 mx-auto" style="max-width: 700px; border-radius: 16px; background: #ffffff;">
        <form asp-action="AnalyzeSkinImage" method="post" enctype="multipart/form-data">
            <div class="mb-4 text-center">
                <div class="upload-zone p-5 rounded-3 mb-3 border-2 border-dashed position-relative" style="border-color: #800020; background-color: #fff9fa; cursor: pointer;">
                    <i class="bi bi-cloud-arrow-up-fill display-3" style="color: #800020;"></i>
                    <h5 class="fw-bold mt-3 text-dark">Kéo thả ảnh hoặc Bấm để tải ảnh mặt lên</h5>
                    <p class="text-muted small">Hỗ trợ các định dạng JPG, PNG, WEBP (Khuyên dùng ảnh chụp cận mặt, ánh sáng tự nhiên)</p>
                    <input type="file" name="skinImage" id="skinImageInput" accept="image/*" required class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" onchange="previewSkinImage(this)" />
                </div>
                
                <div id="imagePreviewContainer" class="d-none text-center mb-3">
                    <img id="imagePreview" src="#" alt="Preview" class="img-thumbnail shadow-sm rounded-3" style="max-height: 250px; object-fit: cover;" />
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                        <i class="bi bi-droplet-half fs-3 text-info me-3"></i>
                        <div>
                            <strong class="d-block text-dark">Độ ẩm & Dầu</strong>
                            <span class="small text-muted">Đánh giá hàng rào độ ẩm</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                        <i class="bi bi-shield-x fs-3 text-danger me-3"></i>
                        <div>
                            <strong class="d-block text-dark">Độ Mụn & Viêm</strong>
                            <span class="small text-muted">Phát hiện tình trạng mụn</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                        <i class="bi bi-sun-fill fs-3 text-warning me-3"></i>
                        <div>
                            <strong class="d-block text-dark">Thâm Nám & Sạm</strong>
                            <span class="small text-muted">Phát hiện sắc tố Melanin</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                        <i class="bi bi-activity fs-3 text-success me-3"></i>
                        <div>
                            <strong class="d-block text-dark">Đàn Hồi & Nếp Nhăn</strong>
                            <span class="small text-muted">Đánh giá mức độ collagen</span>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-pill shadow" style="background-color: #800020; border: none; font-size: 16px;">
                <i class="bi bi-cpu-fill me-2"></i> BẮT ĐẦU PHÂN TÍCH AI
            </button>
        </form>
    </div>
</div>

<script>
    function previewSkinImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('imagePreviewContainer').classList.remove('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
