@{
    ViewData["Title"] = "AI Skincare Hub — MeiLing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- AI Hero -->
<div class="ai-hero">
    <div class="container">
        <span class="ai-badge">✨ AI POWERED</span>
        <h1>AI Skincare Assistant</h1>
        <p>Trợ lý thông minh cá nhân hóa trải nghiệm làm đẹp của bạn</p>
    </div>
</div>

<div class="ai-hub-wrapper py-5" style="background: linear-gradient(180deg, #f8fafc 0%, #fff5f7 100%) !important;">
    <div class="container">

        <!-- Stats -->
        <div class="ai-stats mt-2">
            <div class="ai-stat">
                <span class="ai-stat-num">5</span>
                <span class="ai-stat-label">Tính năng AI</span>
            </div>
            <div class="ai-stat">
                <span class="ai-stat-num">16+</span>
                <span class="ai-stat-label">Thành phần phân tích</span>
            </div>
            <div class="ai-stat">
                <span class="ai-stat-num">5</span>
                <span class="ai-stat-label">Loại da hỗ trợ</span>
            </div>
            <div class="ai-stat">
                <span class="ai-stat-num">24/7</span>
                <span class="ai-stat-label">Tư vấn liên tục</span>
            </div>
        </div>

        <!-- Feature Cards -->
        <div class="ai-grid">
            <a href="@Url.Action("Recommendations", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #f97316, #db2777); --icon-bg: #fff7ed;">
                <div class="ai-card-icon-wrap">🎯</div>
                <h3>AI Gợi ý Sản phẩm</h3>
                <p>Phân tích lịch sử mua hàng của bạn để gợi ý những sản phẩm hoàn toàn phù hợp với nhu cầu và sở thích.</p>
            </a>

            <a href="#" onclick="openChatbot(); return false;" class="ai-card" style="--card-color: linear-gradient(90deg, #7c3aed, #2563eb); --icon-bg: #f3e8ff;">
                <span class="badge-new">Gemini AI</span>
                <div class="ai-card-icon-wrap">🤖</div>
                <h3>AI Chatbot Skincare</h3>
                <p>Chat trực tiếp với AI tư vấn viên skincare được tích hợp Gemini AI, giải đáp mọi câu hỏi về làm đẹp.</p>
            </a>

            <a href="@Url.Action("SkinAnalysis", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #0891b2, #7c3aed); --icon-bg: #ecfeff;">
                <div class="ai-card-icon-wrap">🔬</div>
                <h3>Phân tích Loại da</h3>
                <p>Quiz thông minh 6 câu hỏi phân tích chính xác loại da của bạn: Dầu, Khô, Hỗn hợp, Nhạy cảm hay Da mụn.</p>
            </a>

            <a href="@Url.Action("Routine", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #059669, #0891b2); --icon-bg: #ecfdf5;">
                <div class="ai-card-icon-wrap">✨</div>
                <h3>Routine Chăm sóc Da</h3>
                <p>Xây dựng routine Sáng & Tối cá nhân hóa hoàn toàn theo loại da, kết hợp sản phẩm từ cửa hàng của chúng tôi.</p>
            </a>

            <a href="@Url.Action("Ingredients", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #d97706, #059669); --icon-bg: #fef3c7;">
                <div class="ai-card-icon-wrap">🧬</div>
                <h3>Tìm theo Thành phần</h3>
                <p>Tìm sản phẩm theo thành phần cụ thể: Niacinamide, Retinol, Vitamin C, Ceramide... kèm giải thích khoa học.</p>
            </a>

            <a href="@Url.Action("BookAppointment", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #800020, #e11d48); --icon-bg: #fff0f3;">
                <span class="badge-new">Hot Clinic</span>
                <div class="ai-card-icon-wrap">📅</div>
                <h3>Đặt Lịch Soi Da & Bác Sĩ</h3>
                <p>Đặt lịch hẹn soi da 3D VISIA miễn phí & tư vấn trực tiếp 1:1 với Đội ngũ Bác sĩ CKI Da liễu MeiLing.</p>
            </a>

            <a href="@Url.Action("MyAppointments", "AI")" class="ai-card" style="--card-color: linear-gradient(90deg, #be185d, #7c3aed); --icon-bg: #fce7f3;">
                <div class="ai-card-icon-wrap">📋</div>
                <h3>Lịch Hẹn Của Tôi</h3>
                <p>Xem lại danh sách lịch hẹn soi da & tư vấn bác sĩ đã đăng ký, kiểm tra trạng thái duyệt lịch hẹn.</p>
            </a>
        </div>
    </div>
</div>

<script>
    function openChatbot() {
        const btn = document.getElementById('aiBotBubble');
        if (btn) btn.click();
        else alert('Chatbot đang tải...');
    }
</script>
