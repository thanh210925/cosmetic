@model List<COSMETICC.Models.Product>
@{
    ViewData["Title"] = "AI Gợi ý Sản phẩm — Dành cho bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string reason = ViewBag.Reason ?? "Sản phẩm phổ biến nhất";
}



<div class="rec-hero">
    <div class="container">
        <span style="font-size: 11px; color: #94a3b8; letter-spacing: 1px; font-weight: 700;">✨ AI POWERED</span>
        <h1 class="mt-1">Dành riêng cho bạn</h1>
        <div class="rec-reason">
            <i class="bi bi-stars"></i>
            <span>@reason</span>
        </div>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bag-x"></i>
            <h4 class="fw-bold text-dark mb-2">Chưa có lịch sử mua hàng</h4>
            <p>Mua hàng nhiều hơn để AI hiểu sở thích của bạn và đưa ra gợi ý tốt hơn!</p>
            <a href="@Url.Action("List", "Product")" class="btn btn-danger px-4 mt-2" style="background:#800020; border:none;">
                <i class="bi bi-shop me-1"></i> Khám phá sản phẩm
            </a>
        </div>
    }
    else
    {
        @if (Context.Session.GetString("UserId") == null)
        {
            <div class="alert alert-info border-0 mt-4 text-dark small" style="background: linear-gradient(90deg, #f0f9ff, #e0f2fe); border-left: 4px solid #0891b2 !important;">
                <i class="bi bi-info-circle-fill me-2 text-info"></i>
                <strong>Đăng nhập</strong> để AI phân tích lịch sử mua hàng của bạn và gợi ý chính xác hơn!
                <a href="@Url.Action("Login", "Account")" class="ms-2 fw-bold">Đăng nhập ngay →</a>
            </div>
        }

        <div class="product-grid-ai mt-2">
            @foreach (var product in Model)
            {
                <div class="ai-product-card position-relative">
                    <span class="ai-badge-pill">✨ Dành cho bạn</span>
                    <a href="@Url.Action("Details", "Product", new { id = product.Id })">
                        <img src="@(product.ImageUrl ?? "/img/placeholder.png")" alt="@product.Name" loading="lazy" />
                    </a>
                    <div class="ai-card-body">
                        <div class="ai-card-brand">@(product.Brand?.Name ?? "MeiLing")</div>
                        <div class="ai-card-name">
                            <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="text-decoration-none text-dark">
                                @product.Name
                            </a>
                        </div>
                        @if (product.Reviews.Any())
                        {
                            <div class="mb-1">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <i class="bi @(s <= (int)(product.Reviews.Average(r => r.Rating)) ? "bi-star-fill" : "bi-star")" style="color:#f59e0b; font-size:11px;"></i>
                                }
                                <span class="text-muted" style="font-size:11px;"> (@product.Reviews.Count)</span>
                            </div>
                        }
                        <div class="d-flex align-items-baseline">
                            <span class="ai-card-price">@String.Format("{0:N0}", product.PromoPrice ?? product.Price)₫</span>
                            @if (product.PromoPrice.HasValue)
                            {
                                <span class="ai-card-promo">@String.Format("{0:N0}", product.Price)₫</span>
                            }
                        </div>
                        <a href="@Url.Action("Details", "Product", new { id = product.Id })" 
                           class="btn btn-sm w-100 mt-2 fw-bold" 
                           style="background:#800020; color:white; border:none; border-radius:8px; font-size:12px;">
                            Xem chi tiết →
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
